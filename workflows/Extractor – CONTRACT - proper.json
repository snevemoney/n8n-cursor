        "options": {
          "includeSubfolders": false
        }
      }
    },
    {
      "id": "Switch_File_Type",
      "name": "Switch by file type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [460, 200],
      "parameters": {
        "propertyName": "mimeType",
        "rules": {
          "values": [
            {
              "operation": "contains",
              "value": "image/"
            },
            {
              "operation": "contains",
              "value": "application/pdf"
            }
          ]
        }
      }
    },
    {
      "id": "Drive_Download_PNG",
      "name": "Google Drive: Download PNG",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [700, 120],
      "parameters": {
        "operation": "download",
        "fileId": "={{$json.id}}",
        "options": {
          "download": true
        }
      }
    },
    {
      "id": "Drive_Download_PDF",
      "name": "Google Drive: Download PDF",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [700, 280],
      "parameters": {
        "operation": "download",
        "fileId": "={{$json.id}}",
        "options": {
          "download": true
        }
      }
    },
    {
      "id": "Tesseract_OCR_PNG",
      "name": "Tesseract OCR → text (PNG)",
      "type": "n8n-nodes-base.tesseractOcr",
      "typeVersion": 1,
      "position": [940, 120],
      "parameters": {
        "operation": "ocr",
        "imagePropertyName": "data",
        "options": {
          "preserveInterwordSpaces": true,
          "splitPages": false
        }
      }
    },
    {
      "id": "LlamaIndex_PDF",
      "name": "LlamaIndex API (PDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [940, 280],
      "parameters": {
        "url": "https://api.llamaindex.ai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_LLAMAINDEX_API_KEY"
            }
          ]
        },
        "sendHeaders": true,
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama-3.1-8b-instruct"
            },
            {
              "name": "messages",
              "value": "[{\"role\": \"user\", \"content\": \"Extract all text from this PDF document: {{$json.data}}\"}]"
            },
            {
              "name": "max_tokens",
              "value": "4000"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "Wait_Poll_Logic",
      "name": "Wait/Poll Logic",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1180, 200],
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "Code_Extract",
      "name": "Code: extract contract fields",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [1420, 200],
      "parameters": {
        "functionCode": "// Extract contract-specific fields\nconst text = ($json.text || $json.choices?.[0]?.message?.content || '').toLowerCase();\nconst id_number = $json.id_number || '';\n\n// Contract-specific extraction patterns\nconst patterns = {\n  borrower_name: /borrower[\\s\\-]*name[\\s\\-]*:?[\\s\\-]*([^\\n]+)/i,\n  lender_name: /lender[\\s\\-]*name[\\s\\-]*:?[\\s\\-]*([^\\n]+)/i,\n  loan_amount: /(?:loan|principal)[\\s\\-]*amount[\\s\\-]*:?[\\s\\-]*\\$?([0-9,]+(?:\\.\\d{2})?)/i,\n  interest_rate: /(?:interest|rate)[\\s\\-]*:?[\\s\\-]*([0-9]+(?:\\.\\d+)?)[\\s\\-]*%/i,\n  term_months: /(?:term|duration)[\\s\\-]*:?[\\s\\-]*([0-9]+)[\\s\\-]*(?:months?|years?)/i,\n  start_date: /(?:start|effective)[\\s\\-]*date[\\s\\-]*:?[\\s\\-]*([0-9]{1,2}[\\/\\-][0-9]{1,2}[\\/\\-][0-9]{2,4})/i,\n  maturity_date: /(?:maturity|end)[\\s\\-]*date[\\s\\-]*:?[\\s\\-]*([0-9]{1,2}[\\/\\-][0-9]{1,2}[\\/\\-][0-9]{2,4})/i\n};\n\nconst extracted = {};\n\n// Extract each field\nObject.entries(patterns).forEach(([key, pattern]) => {\n  const match = text.match(pattern);\n  if (match) {\n    extracted[key] = match[1].trim();\n  }\n});\n\n// Add metadata\nconst result = {\n  job_id: $json.job_id || (\"jb_\" + Date.now()),\n  document_type: 'CONTRACT',\n  id_number: id_number,\n  extraction_confidence: 0.85,\n  extracted_at: new Date().toISOString(),\n  values: extracted\n};\n\nreturn [{ json: result }];"
      }
    }
  ],
  "connections": {
