      "id": "LlamaIndex_PDF",
      "name": "LlamaIndex API (PDF)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [940, 280],
      "parameters": {
        "url": "https://api.llamaindex.ai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_LLAMAINDEX_API_KEY"
            }
          ]
        },
        "sendHeaders": true,
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama-3.1-8b-instruct"
            },
            {
              "name": "messages",
              "value": "[{\"role\": \"user\", \"content\": \"Extract all text from this PDF document: {{$json.data}}\"}]"
            },
            {
              "name": "max_tokens",
              "value": "4000"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "Wait_Poll_Logic",
      "name": "Wait/Poll Logic",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1180, 200],
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "Code_Classify",
      "name": "Code: classify + id_number",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [1420, 200],
      "parameters": {
        "functionCode": "// Heuristic classification + id_number\nconst text = ($json.text || $json.choices?.[0]?.message?.content || '').toLowerCase();\nconst job_id = $json.job_id || (\"jb_\" + Date.now());\nconst bins = [\n  {bin:'CONTRACT',   kw:['loan agreement','governing law','borrower','lender']},\n  {bin:'BANKING',    kw:['void cheque','transit','institution','account number','bank statement']},\n  {bin:'CARFAX',     kw:['carfax','vehicle history','odometer','accident']},\n  {bin:'DEALER BOS', kw:['bill of sale','sale price','dealer','purchase price']},\n  {bin:'INSURANCE',  kw:['policy','binder','coverage','deductible','insured']},\n  {bin:'PPSA',       kw:['ppsa','financing statement','registration']},\n  {bin:'UCC',        kw:['ucc','filing number','secured party']},\n  {bin:'OWNERSHIP',  kw:['certificate of title','plate','owner']} \n];\nlet best='MISC', score=0;\nfor (const b of bins){ const s=b.kw.reduce((c,k)=>c+(text.includes(k)?1:0),0); if(s>score){score=s;best=b.bin;} }\nconst idnum = ( ($json.text||'').match(/\\b(?:agreement|contract)\\s*(?:no\\.?|number|#)\\s*[:\\-]?\\s*([A-Z0-9\\-\\/]+)/i)?.[1] || '' ).trim();\nreturn [{ json: { job_id, bin: score?best:'UNASGD FAX', confidence: score? Math.min(1, 0.3 + score*0.15):0.1, id_number:idnum, file_url: `https://drive.google.com/uc?id=${$items(1)[0].json.id}` } }];"
      }
    },
    {
      "id": "Code_Response",
      "name": "Code: build response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [1660, 200],
      "parameters": {
        "functionCode": "// Build response with file_url\nconst fileId = $items(1)[0].json.id; // from Google Drive Trigger\nconst fileUrl = `https://drive.google.com/uc?id=${fileId}`;\nconst out = { ...$json, file_url: fileUrl };\nreturn [{ json: out }];"
      }
    }
  ],
