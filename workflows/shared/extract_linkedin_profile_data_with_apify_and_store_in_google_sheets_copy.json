    {
      "parameters": {
        "jsCode": "// Utility helpers\nconst coalesce = (...candidates) => {\n  for (const v of candidates) {\n    if (v !== undefined && v !== null && String(v).trim() !== \"\") return v;\n  }\n  return \"\";\n};\n\nconst getNum = (v) => {\n  if (v === undefined || v === null || v === \"\") return 0;\n  const n = Number(String(v).replace(/[, ]+/g, \"\"));\n  return Number.isFinite(n) ? n : 0;\n};\n\n// Source objects\nconst src = $json;\nconst ap  = src.apifyOutput || src.apify || {}; // if you merged Apify data earlier\n\n// Read with multiple fallbacks (handles weird keys + spaces)\nconst fullName        = coalesce(src[\"Full Name\"], src.fullName, src.Name, ap.fullName, ap.name);\nconst followersCount  = getNum(coalesce(src[\"Followers\"], src.followersCount, src.followers, ap.followersCount));\nconst followsCount    = getNum(coalesce(src[\"Following\"], src.followsCount, src.following, ap.followsCount));\nconst biography       = coalesce(src.biography, ap.biography, src[\"Business Category\"], src.businessCategory);\nconst profilePicUrl   = coalesce(src.profilePicUrl, ap.profilePicUrl, src.avatar, src.photo, ap.avatar, ap.photo);\nconst businessCategory= coalesce(src.businessCategory, src[\"Business Category\"], ap.businessCategory);\nconst website         = coalesce(src.website, ap.website, src.externalUrl, ap.externalUrl, src[\"Website\"]);\nconst linkedinlink    = coalesce(src.profileUrl, src[\"linkedin link \"], src[\"linkedin link\"], src.linkedin, ap.profileUrl);\nconst email           = coalesce(src.email, src.Email, ap.email);\nconst mobileNumber    = coalesce(src.mobileNumber, src[\"phone number\"], src.phone, src.Phone, ap.mobileNumber);\n\n// Experiences can be string or array; normalize to a single string\nlet experiences       = coalesce(src.experiences, ap.experiences);\nif (Array.isArray(experiences)) {\n  experiences = experiences.map(e =>\n    e?.title || e?.role || e?.position || e?.company || (typeof e === \"string\" ? e : JSON.stringify(e))\n  ).join(\" | \");\n}\n\n// Logo: prefer explicit logo, else fall back to profile pic\nconst logo            = coalesce(src.logo, ap.logo, profilePicUrl);\n\n// Return exactly the shape you asked for\nreturn [\n  {\n    json: {\n      Name: fullName,\n      followersCount,\n      followsCount,\n      biography,\n      profilePicUrl,\n      businessCategory,\n      website,\n      linkedinlink,\n      email,\n      mobileNumber,\n      experiences: experiences || \"\",\n      logo\n    }\n  }\n];\n"
      },
