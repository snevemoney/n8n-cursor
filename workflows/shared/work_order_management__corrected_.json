    {
      "parameters": {
        "jsCode": "// Basic schema guard for create\nconst b = $json.body || {};\nconst required = ['tenantId','title','priority','requestedBy'];\nconst missing = required.filter(k => b[k] === undefined || b[k] === null || b[k] === '');\nif (missing.length) {\n  return { json: { error: 'VALIDATION_ERROR', missing } };\n}\nreturn {\n  json: {\n    tenantId: b.tenantId,\n    assetId: b.assetId ?? null,\n    title: b.title,\n    description: b.description ?? null,\n    priority: b.priority, // e.g., low|medium|high|urgent\n    requestedBy: b.requestedBy,\n    scheduledDate: b.scheduledDate ?? null,\n    dueDate: b.dueDate ?? null,\n  }\n};\n"
      },
      "id": "2e6c8aeb-bc90-4eb0-a6f3-91ae138bc1d0",
      "name": "Validate Create Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO work_orders (tenant_id, asset_id, title, description, priority, status, requested_by, scheduled_date, due_date) VALUES ('{{ $json.tenantId }}', {{ $json.assetId }}, '{{ $json.title }}', '{{ $json.description }}', '{{ $json.priority }}', 'pending', '{{ $json.requestedBy }}', '{{ $json.scheduledDate }}'::timestamptz, '{{ $json.dueDate }}'::timestamptz) RETURNING *;\n",
        "options": {}
      },
      "id": "985e6062-38a4-4615-bff5-ce5ee9cdecf2",
      "name": "Create Work Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        448,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT wo.*, ta.asset_name, ta.asset_category, v.vendor_name FROM work_orders wo LEFT JOIN tenant_assets ta ON wo.asset_id = ta.id LEFT JOIN vendors v ON wo.vendor_id = v.id WHERE wo.tenant_id = '{{ $json.tenantId }}' ORDER BY wo.created_at DESC;",
        "options": {}
      },
      "id": "948ef754-8f5f-400b-9c7a-702886ccac90",
      "name": "Get Work Orders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        224
      ],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst status = body.status;\nconst allowed = ['pending','in-progress','on-hold','completed','cancelled'];\nif (!allowed.includes(status)) {\n  return { json: { error: 'INVALID_STATUS', allowed } };\n}\nreturn {\n  json: {\n    status,\n    resolutionNotes: body.resolutionNotes ?? null,\n    orderId: $json.pathParameters?.orderId\n  }\n};\n"
      },
      "id": "afbff5d9-04a6-46c0-ac9a-2d1447a686fe",
      "name": "Validate Update Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        448
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE work_orders SET status = '{{ $json.status }}', completed_date = CASE WHEN '{{ $json.status }}' = 'completed' THEN NOW() ELSE completed_date END, resolution_notes = '{{ $json.resolutionNotes }}', updated_at = NOW() WHERE id = {{ $json.orderId }} RETURNING *;\n",
        "options": {}
      },
