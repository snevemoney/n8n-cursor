    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO document_metadata (id, title, url, schema, tenant_id, user_id, created_at) VALUES ('{{ $('Extract File Data').item.json.fileId }}', '{{ $('Extract File Data').item.json.fileName }}', '{{ $('Extract File Data').item.json.fileUrl }}', '{{ $('Extract File Data').item.json.fileType }}', '{{ $('Get Tenant from Folder').item.json.tenant_id }}', 'system', NOW()) ON CONFLICT (id) DO UPDATE SET title = EXCLUDED.title, url = EXCLUDED.url, updated_at = NOW() RETURNING *",
        "options": {}
      },
      "id": "insert-metadata",
      "name": "Insert Document Metadata",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [200, 400],
