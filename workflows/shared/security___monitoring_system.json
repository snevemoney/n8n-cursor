    {
      "parameters": {
        "jsCode": "// Validate webhook signature (simplified version without crypto module)\nconst receivedSignature = $json.data?.signature;\nconst payload = $json.data?.payload;\nconst secret = process.env.WEBHOOK_SECRET || 'default-secret';\n\n// Simple HMAC validation without crypto module\n// For production, you'd want to use a proper crypto implementation\nlet valid = false;\n\nif (receivedSignature && payload) {\n  // This is a simplified validation - in production, implement proper HMAC\n  // For now, just check if signature exists\n  const expectedLength = 64; // SHA256 hex length\n  valid = receivedSignature.length === expectedLength && secret;\n}\n\nreturn {\n  json: {\n    valid: valid,\n    message: valid ? 'Webhook signature validated' : 'Invalid signature'\n  }\n};"
      },
      "id": "070eb15e-f446-4cc7-a279-5d255c5160b6",
