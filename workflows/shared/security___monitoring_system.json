    {
      "parameters": {
        "jsCode": "// Get the webhook body data\nconst webhookData = $input.item.json;\n\n// Extract action from body or use fallback\nconst action = webhookData.body?.action || \n               webhookData?.action || \n               webhookData.params?.action ||\n               'monitor';\n\n// Get data payload\nconst payload = webhookData.body?.data || \n                webhookData?.data || \n                {};\n\nreturn {\n  json: {\n    securityType: action,\n    data: payload,\n    // Keep original data for downstream nodes\n    headers: webhookData.headers,\n    body: webhookData.body\n  }\n};"
      },
