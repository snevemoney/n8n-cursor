        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as request_count FROM rate_limits\nWHERE ip_address = '{{ $json.ip_address }}'\nAND created_at > NOW() - INTERVAL '1 minute'",
        "options": {}
