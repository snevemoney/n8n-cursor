      "parameters": {
        "jsCode": "// Send alert via webhook\nconst alertData = $json.data;\nconst priority = alertData.severity === 'critical' ? 'high' : 'normal';\nreturn { json: { alert: { priority, message: alertData.message, timestamp: new Date().toISOString() } } };"
