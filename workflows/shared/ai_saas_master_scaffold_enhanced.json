    {
      "id": "assemble-response",
      "name": "Assemble Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "functionCode": "const originalPayload = $node['Prepare Payload'].json;\nconst aiResponse = $input.all().find(item => item.json.choices || item.json.message);\nconst dbSaveResult = $input.all().find(item => item.json.request_id || item.json.id);\nconst analyticsResult = $input.all().find(item => item.json.tokens_consumed !== undefined);\n\n// Extract AI response content\nlet responseContent = '';\nlet tokensUsed = 0;\n\nif (aiResponse) {\n  if (aiResponse.json.choices && aiResponse.json.choices[0]) {\n    responseContent = aiResponse.json.choices[0].message.content;\n    tokensUsed = aiResponse.json.usage?.total_tokens || 0;\n  } else if (aiResponse.json.message) {\n    responseContent = aiResponse.json.message;\n  }\n}\n\n// Calculate performance metrics\nconst responseTime = Date.now() - new Date(originalPayload.timestamp).getTime();\n\n// Assemble comprehensive response\nconst response = {\n  success: true,\n  request_id: originalPayload.request_id,\n  timestamp: new Date().toISOString(),\n  \n  // Core response data\n  response: {\n    content: responseContent,\n    action: originalPayload.action,\n    model_used: originalPayload.ai_config.model\n  },\n  \n  // User and session info\n  session: {\n    user_id: originalPayload.user_id,\n    session_id: originalPayload.session_id,\n    service_tier: originalPayload.service_tier\n  },\n  \n  // Performance metrics\n  metrics: {\n    response_time_ms: responseTime,\n    tokens_used: tokensUsed,\n    characters_generated: responseContent.length,\n    processing_status: 'completed'\n  },\n  \n  // Database and storage\n  storage: {\n    conversation_saved: !!dbSaveResult,\n    analytics_updated: !!analyticsResult,\n    database_id: dbSaveResult?.json?.id || null\n  },\n  \n  // Additional metadata\n  metadata: {\n    features_used: originalPayload.features_enabled,\n    notifications_sent: originalPayload.notifications,\n    api_version: '2.0',\n    workflow_version: 'enhanced'\n  }\n};\n\nreturn response;"
      }
    },
