    {
      "id": "prepare-payload",
      "name": "Prepare Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        300,
        300
      ],
      "parameters": {
        "functionCode": "const input = $input.first().json;\n\n// Enhanced payload preparation with AI service routing\nconst payload = {\n  // Request metadata\n  request_id: `saas_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n  timestamp: new Date().toISOString(),\n  client_ip: $input.first().headers['x-forwarded-for'] || 'unknown',\n  \n  // Core request data\n  action: input.action || 'chat',\n  user_id: input.user_id || 'anonymous',\n  session_id: input.session_id || Math.random().toString(36).substr(2, 9),\n  \n  // AI-specific parameters\n  ai_config: {\n    model: input.model || 'gpt-4',\n    temperature: input.temperature || 0.7,\n    max_tokens: input.max_tokens || 1500,\n    stream: input.stream || false\n  },\n  \n  // Content and context\n  user_input: input.message || input.prompt || input.query || '',\n  context: input.context || '',\n  conversation_history: input.conversation_history || [],\n  \n  // Business logic\n  service_tier: input.service_tier || 'basic',\n  features_enabled: input.features || ['chat', 'research', 'analysis'],\n  \n  // Database and storage\n  save_to_db: input.save_conversation !== false,\n  supabase_config: {\n    table: input.table || 'conversations',\n    user_table: 'users',\n    analytics_table: 'usage_analytics'\n  },\n  \n  // Notification settings\n  notifications: {\n    discord_enabled: input.notify_discord || false,\n    email_enabled: input.notify_email || false,\n    webhook_enabled: input.webhook_callback || false\n  },\n  \n  // Validation flags\n  validated: false,\n  errors: []\n};\n\n// Validate required fields\nif (!payload.user_input || payload.user_input.length < 1) {\n  payload.errors.push('User input is required');\n}\n\nif (payload.user_input.length > 4000) {\n  payload.errors.push('User input too long (max 4000 characters)');\n}\n\nif (!['basic', 'premium', 'enterprise'].includes(payload.service_tier)) {\n  payload.service_tier = 'basic';\n}\n\npayload.validated = payload.errors.length === 0;\n\nreturn payload;"
      }
    },
