{
  "name": "Advanced Features System",
  "nodes": [
    {
      "parameters": {
        "path": "/advanced",
        "httpMethod": "POST"
      },
      "id": "advanced-webhook-entry",
      "name": "Advanced Features Entry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different advanced features\nconst featureType = $input.item.json.body?.type || 'multi-language';\n\nreturn {\n  json: {\n    featureType,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "route-feature-type",
      "name": "Route Feature Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "multi-lang-condition",
              "leftValue": "={{ $json.featureType }}",
              "rightValue": "multi-language",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ocr-condition",
              "leftValue": "={{ $json.featureType }}",
              "rightValue": "ocr",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "content-extract-condition",
              "leftValue": "={{ $json.featureType }}",
              "rightValue": "content-extract",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "data-export-condition",
              "leftValue": "={{ $json.featureType }}",
              "rightValue": "data-export",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-feature-type",
      "name": "Route by Feature Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Multi-language support\nconst supportedLanguages = ['en', 'fr', 'es', 'de', 'zh', 'ja'];\nconst targetLanguage = $json.data.language || 'en';\n\nreturn {\n  json: {\n    supported: supportedLanguages.includes(targetLanguage),\n    targetLanguage,\n    message: `Language support ready: ${targetLanguage}`\n  }\n};"
      },
      "id": "handle-multi-language",
      "name": "Handle Multi-Language",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// OCR processing\nconst ocrEngine = 'tesseract';\nconst fileUrl = $json.data.fileUrl;\n\nreturn {\n  json: {\n    status: 'processing',\n    engine: ocrEngine,\n    fileUrl,\n    extractedText: 'Sample extracted text from OCR...'\n  }\n};"
      },
      "id": "process-ocr",
      "name": "Process OCR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "// Content extraction\nconst contentType = $json.data.contentType || 'pdf';\nconst contentUrl = $json.data.contentUrl;\n\nreturn {\n  json: {\n    contentType,\n    contentUrl,\n    extractedData: {\n      text: 'Extracted text content...',\n      metadata: { author: 'Unknown', pages: 10 }\n    }\n  }\n};"
      },
      "id": "extract-content",
      "name": "Extract Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM tenant_assets WHERE tenant_id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.tenantId}` }}"
        }
      },
      "id": "export-data",
      "name": "Export Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-advanced",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
