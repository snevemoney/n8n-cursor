      "parameters": {
        "jsCode": "// Route to different testing operations\nconst testType = $input.item.json.body?.type || 'smoke';\n\nreturn {\n  json: {\n    testType,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "2c8e4fa0-df8e-43f3-985a-28a4ba5814b9",
      "name": "Route Test Type",
