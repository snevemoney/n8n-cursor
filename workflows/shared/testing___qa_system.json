      "id": "b35ed4ec-58b5-4903-8156-866f9a3e69ad",
      "name": "Route by Test Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -480,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Smoke test - basic health checks\nconst tests = [\n  { name: 'Database Connection', passed: true },\n  { name: 'API Endpoints', passed: true },\n  { name: 'Authentication', passed: true }\n];\n\nreturn {\n  json: {\n    testType: 'smoke',\n    results: tests,\n    passed: tests.every(t => t.passed),\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "a6ff80da-5de4-49c6-95e1-74579a6f1186",
      "name": "Run Smoke Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Load test simulation\nconst requests = $json.data.requestCount || 100;\nconst concurrentUsers = $json.data.concurrentUsers || 10;\n\nreturn {\n  json: {\n    testType: 'load',\n    requests,\n    concurrentUsers,\n    avgResponseTime: Math.random() * 100 + 50,\n    maxResponseTime: Math.random() * 200 + 100,\n    successRate: 0.98\n  }\n};"
      },
      "id": "3d91496e-3215-43b0-ac0f-45a608281ab7",
      "name": "Run Load Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// E2E test simulation\nconst scenarios = ['user-signup', 'tenant-onboarding', 'file-upload', 'chat-interaction'];\n\nreturn {\n  json: {\n    testType: 'e2e',\n    scenarios,\n    passedScenarios: scenarios.length - 1,\n    failedScenarios: 1,\n    totalScenarios: scenarios.length\n  }\n};"
      },
      "id": "70af1c7d-7aac-4ed5-8b6b-d6baa7c71703",
      "name": "Run E2E Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "// A/B test simulation\nconst variantA = { name: 'GPT-4', responseTime: 200, accuracy: 0.95 };\nconst variantB = { name: 'GPT-3.5-Turbo', responseTime: 150, accuracy: 0.90 };\n\nreturn {\n  json: {\n    testType: 'ab',\n    variantA,\n    variantB,\n    winner: variantB.responseTime < variantA.responseTime ? 'B' : 'A'\n  }\n};"
      },
      "id": "e018c7c9-9c41-4cc1-b162-34b27d80b3b9",
      "name": "Run A/B Test",
      "type": "n8n-nodes-base.code",
