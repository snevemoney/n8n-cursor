{
  "name": "Compliance & Audit System",
  "nodes": [
    {
      "parameters": {
        "path": "/compliance",
        "httpMethod": "POST"
      },
      "id": "compliance-webhook-entry",
      "name": "Compliance Entry Point",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different compliance operations\nconst complianceType = $input.item.json.body?.type || 'audit-log';\n\nreturn {\n  json: {\n    complianceType,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "route-compliance-type",
      "name": "Route Compliance Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "audit-log-condition",
              "leftValue": "={{ $json.complianceType }}",
              "rightValue": "audit-log",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "compliance-report-condition",
              "leftValue": "={{ $json.complianceType }}",
              "rightValue": "compliance-report",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "data-retention-condition",
              "leftValue": "={{ $json.complianceType }}",
              "rightValue": "data-retention",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "gdpr-condition",
              "leftValue": "={{ $json.complianceType }}",
              "rightValue": "gdpr",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-compliance-type",
      "name": "Route by Compliance Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_logs (user_id, action, resource, metadata)\nVALUES ($1, $2, $3, $4)\nRETURNING *;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.userId, \"$2\": $json.data.action, \"$3\": $json.data.resource, \"$4\": JSON.stringify($json.data.metadata)}` }}"
        }
      },
      "id": "log-audit",
      "name": "Log Audit Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  tenant_id,\n  compliance_type,\n  status,\n  last_check,\n  next_check\nFROM compliance_records\nWHERE tenant_id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.tenantId}` }}"
        }
      },
      "id": "generate-compliance-report",
      "name": "Generate Compliance Report",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM chat_sessions WHERE tenant_id = $1 AND created_at < NOW() - INTERVAL '90 days';",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.tenantId}` }}"
        }
      },
      "id": "enforce-data-retention",
      "name": "Enforce Data Retention",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM users WHERE user_id = $1 AND email = $2;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.userId, \"$2\": $json.data.userEmail}` }}"
        }
      },
      "id": "handle-gdpr-request",
      "name": "Handle GDPR Request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, timestamp: new Date().toISOString() } }}"
      },
      "id": "respond-compliance",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
