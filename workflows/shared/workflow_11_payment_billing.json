{
  "name": "Payment & Billing System",
  "nodes": [
    {
      "parameters": {
        "path": "/billing",
        "httpMethod": "POST"
      },
      "id": "billing-webhook-entry",
      "name": "Billing Entry Point",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different billing operations\nconst billingAction = $input.item.json.body?.action || 'get-status';\n\nreturn {\n  json: {\n    action: billingAction,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "route-billing-action",
      "name": "Route Billing Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "create-sub-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "create-subscription",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cancel-sub-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "cancel-subscription",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "upgrade-sub-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "upgrade-subscription",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "downgrade-sub-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "downgrade-subscription",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-billing-action",
      "name": "Route by Billing Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO subscriptions (tenant_id, plan_id, status, billing_period)\nVALUES ($1, $2, 'active', $3)\nRETURNING *;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.tenantId, \"$2\": $json.data.planId, \"$3\": $json.data.billingPeriod}` }}"
        }
      },
      "id": "create-subscription",
      "name": "Create Subscription",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE subscriptions SET status = 'cancelled', cancelled_at = NOW() WHERE id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.subscriptionId}` }}"
        }
      },
      "id": "cancel-subscription",
      "name": "Cancel Subscription",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE subscriptions SET plan_id = $2, upgraded_at = NOW() WHERE id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.subscriptionId, \"$2\": $json.data.newPlanId}` }}"
        }
      },
      "id": "upgrade-subscription",
      "name": "Upgrade Subscription",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE subscriptions SET plan_id = $2, downgraded_at = NOW() WHERE id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.subscriptionId, \"$2\": $json.data.newPlanId}` }}"
        }
      },
      "id": "downgrade-subscription",
      "name": "Downgrade Subscription",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-billing",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
