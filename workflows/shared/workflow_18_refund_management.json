{
  "name": "Refund Management System",
  "nodes": [
    {
      "parameters": {
        "path": "/refunds",
        "httpMethod": "POST"
      },
      "id": "refund-webhook-entry",
      "name": "Refund Entry Point",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different refund operations\nconst refundAction = $input.item.json.body?.action || 'process';\n\nreturn {\n  json: {\n    action: refundAction,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "route-refund-action",
      "name": "Route Refund Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "process-refund-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "process",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "approve-refund-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "reject-refund-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "reject",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "partial-refund-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "partial",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-refund-action",
      "name": "Route by Refund Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO refunds (invoice_id, amount, reason, status, tenant_id)\nVALUES ($1, $2, $3, 'pending', $4)\nRETURNING *;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.invoiceId, \"$2\": $json.data.amount, \"$3\": $json.data.reason, \"$4\": $json.data.tenantId}` }}"
        }
      },
      "id": "process-refund",
      "name": "Process Refund Request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE refunds SET status = 'approved', approved_by = $2, approved_at = NOW() WHERE id = $1;\nUPDATE invoices SET refunded_amount = amount WHERE id = (SELECT invoice_id FROM refunds WHERE id = $1);",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.refundId, \"$2\": $json.data.approvedBy}` }}"
        }
      },
      "id": "approve-refund",
      "name": "Approve Refund",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE refunds SET status = 'rejected', rejected_reason = $2, rejected_at = NOW() WHERE id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.refundId, \"$2\": $json.data.rejectionReason}` }}"
        }
      },
      "id": "reject-refund",
      "name": "Reject Refund",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE refunds SET status = 'approved', refunded_amount = $2, approved_at = NOW() WHERE id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.refundId, \"$2\": $json.data.partialAmount}` }}"
        }
      },
      "id": "process-partial-refund",
      "name": "Process Partial Refund",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "fromEmail": "noreply@saas-chatbot.com",
        "toEmail": "={{ $json.data.customerEmail }}",
        "subject": "Refund Processed",
        "html": "={{ `<h1>Refund Notification</h1><p>Your refund of ${{ $json.data.amount }} has been {{ $json.status }}.</p>` }}",
        "options": {}
      },
      "id": "send-refund-notification",
      "name": "Send Refund Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-refund",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1340,
        300
      ]
    }
  ],
