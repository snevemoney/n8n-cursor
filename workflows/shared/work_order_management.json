    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE work_orders SET status = '{{ $json.body.status }}', completed_date = CASE WHEN '{{ $json.body.status }}' = 'completed' THEN NOW() ELSE completed_date END, resolution_notes = '{{ $json.body.resolutionNotes }}', updated_at = NOW() WHERE id = {{ $json.pathParameters.orderId }} RETURNING *",
        "options": {}
