    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO work_orders (tenant_id, asset_id, title, description, priority, status, requested_by, scheduled_date, due_date) VALUES ('{{ $json.body.tenantId }}', {{ $json.body.assetId }}, '{{ $json.body.title }}', '{{ $json.body.description }}', '{{ $json.body.priority }}', 'pending', '{{ $json.body.requestedBy }}', '{{ $json.body.scheduledDate }}', '{{ $json.body.dueDate }}') RETURNING *",
        "options": {}
      },
      "id": "3ee05f0f-7610-4556-ab32-49bcf49c8aad",
      "name": "Create Work Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT wo.*, ta.asset_name, ta.asset_category, v.vendor_name FROM work_orders wo LEFT JOIN tenant_assets ta ON wo.asset_id = ta.id LEFT JOIN vendors v ON wo.vendor_id = v.id WHERE wo.tenant_id = '{{ $json.body.tenantId }}' ORDER BY wo.created_at DESC",
        "options": {}
      },
      "id": "bfeb5271-a5eb-485c-8b49-f259d02e857a",
      "name": "Get Work Orders",
      "type": "n8n-nodes-base.postgres",
