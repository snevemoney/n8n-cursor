{
  "name": "Analytics & Reporting System",
  "nodes": [
    {
      "parameters": {
        "path": "/analytics",
        "httpMethod": "GET"
      },
      "id": "analytics-webhook-entry",
      "name": "Analytics Entry Point",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different analytics operations\nconst analyticsType = $input.item.json.query?.type || 'usage';\n\nreturn {\n  json: {\n    analyticsType,\n    tenantId: $input.item.json.query?.tenantId\n  }\n};"
      },
      "id": "route-analytics-type",
      "name": "Route Analytics Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "usage-condition",
              "leftValue": "={{ $json.analyticsType }}",
              "rightValue": "usage",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "performance-condition",
              "leftValue": "={{ $json.analyticsType }}",
              "rightValue": "performance",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "champion-challenger-condition",
              "leftValue": "={{ $json.analyticsType }}",
              "rightValue": "model-comparison",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-analytics-type",
      "name": "Route by Analytics Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  COUNT(*) as total_requests,\n  COUNT(DISTINCT user_id) as unique_users,\n  AVG(response_time_ms) as avg_response_time\nFROM request_logs\nWHERE tenant_id = $1\nAND created_at > NOW() - INTERVAL '30 days';",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.tenantId}` }}"
        }
      },
      "id": "get-usage-analytics",
      "name": "Get Usage Analytics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  model,\n  COUNT(*) as request_count,\n  AVG(response_time_ms) as avg_response_time,\n  AVG(token_usage) as avg_token_usage\nFROM request_logs\nWHERE tenant_id = $1\nAND created_at > NOW() - INTERVAL '30 days'\nGROUP BY model;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.tenantId}` }}"
        }
      },
      "id": "get-performance-analytics",
      "name": "Get Performance Analytics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  A.model as champion_model,\n  B.model as challenger_model,\n  A.avg_response_time as champion_avg_time,\n  B.avg_response_time as challenger_avg_time,\n  A.avg_token_usage as champion_tokens,\n  B.avg_token_usage as challenger_tokens\nFROM (\n  SELECT model, AVG(response_time_ms) as avg_response_time, AVG(token_usage) as avg_token_usage\n  FROM request_logs\n  WHERE tenant_id = $1 AND model = $2\n  AND created_at > NOW() - INTERVAL '30 days'\n  GROUP BY model\n) A\nCROSS JOIN (\n  SELECT model, AVG(response_time_ms) as avg_response_time, AVG(token_usage) as avg_token_usage\n  FROM request_logs\n  WHERE tenant_id = $1 AND model = $3\n  AND created_at > NOW() - INTERVAL '30 days'\n  GROUP BY model\n) B;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.tenantId, \"$2\": 'gpt-4', \"$3\": 'gpt-3.5-turbo'}` }}"
        }
      },
      "id": "compare-models",
      "name": "Compare Models (Champion vs Challenger)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-analytics",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
