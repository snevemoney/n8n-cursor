    },
    {
      "parameters": {
        "jsCode": "// Detect and log incident\n// Generate a UUID using available methods\nfunction generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.random() * 16 | 0;\n    const v = c == 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nconst incident = {\n  id: generateUUID(),\n  type: $json.emergencyType || $json.data?.type || 'emergency',\n  severity: $json.severity || $json.data?.severity || 'medium',\n  detectedAt: new Date().toISOString(),\n  affectedServices: $json.affectedServices || $json.data?.affectedServices || [],\n  description: $json.description || $json.data?.description || 'Emergency incident detected'\n};\n\nreturn {\n  json: {\n    incident,\n    status: 'detected',\n    timestamp: new Date().toISOString()\n  }\n};\n\nreturn {\n  json: {\n    incident,\n    requiresEscalation: incident.severity === 'critical' || incident.severity === 'high'\n  }\n};"
      },
      "id": "b3cf1f2f-1802-418c-bc5a-4b6d642d9ed4",
      "name": "Detect Incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        208
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO incidents (tenant_id, incident_type, severity, title, description, reported_by, reported_at, status)\nVALUES (\n  'test-tenant-webhook-validation',  -- Hardcoded for testing\n  'emergency',\n  'high',\n  'Emergency Incident',\n  'Emergency escalation',\n  'system',\n  NOW(),\n  'open'\n) RETURNING *;",
        "options": {}
      },
      "id": "7d36bd3a-227d-41eb-a406-6e5699a13cec",
      "name": "Escalate Incident",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        464,
        432
      ],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Restore service\nconst restoration = {\n  action: 'restore',\n  service: $json.data.serviceName,\n  method: 'auto',\n  fallback: true,\n  rollback: false\n};\n\nreturn {\n  json: {\n    restoration,\n    status: 'in-progress',\n    estimatedTime: '5-15 minutes'\n  }\n};"
      },
      "id": "e67f8936-9218-46a1-a718-a6ee3899487d",
      "name": "Restore Service",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        656
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  incident_id,\n  type,\n  severity,\n  description,\n  status,\n  created_at,\n  resolved_at\nFROM incidents\nWHERE tenant_id = $1\nORDER BY created_at DESC\nLIMIT 10;",
        "options": {}
      },
