      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/content_creations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "headers": {
          "Content-Type": "application/json",
          "Prefer": "return=representation"
        },
        "body": {
          "request_id": "={{ $node['Content Request Validator'].json['request_id'] }}",
          "master_request_id": "={{ $node['Content Request Validator'].json['master_request_id'] }}",
          "content_type": "={{ $node['Content Request Validator'].json['content_type'] }}",
