  "nodes": [
    {
      "id": "content-webhook-trigger",
      "name": "Content Creation Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "content-creation",
        "options": {}
      }
    },
    {
      "id": "content-request-validator",
      "name": "Content Request Validator",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        300,
        300
      ],
      "parameters": {
        "functionCode": "const input = $input.first().json;\n\n// Validate content creation request\nconst request = {\n  request_id: `content_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n  timestamp: new Date().toISOString(),\n  master_request_id: input.master_request_id || null,\n  \n  // Content specifications\n  content_type: input.content_type || 'blog_post',\n  topic: input.topic || 'General content',\n  platforms: input.platforms || ['web'],\n  user_id: input.user_id || 'anonymous',\n  service_tier: input.service_tier || 'basic',\n  \n  // Content requirements\n  word_count: input.word_count || 800,\n  tone: input.tone || 'professional',\n  style: input.style || 'informative',\n  target_audience: input.target_audience || 'general',\n  \n  // AI configuration\n  ai_config: input.ai_config || {\n    model: 'gpt-4',\n    temperature: 0.7,\n    max_tokens: 2000\n  },\n  \n  // Validation\n  validated: false,\n  errors: []\n};\n\n// Validate required fields\nif (!request.topic || request.topic.length < 5) {\n  request.errors.push('Topic must be at least 5 characters long');\n}\n\nif (!['blog_post', 'social_media', 'email', 'article', 'newsletter'].includes(request.content_type)) {\n  request.errors.push('Invalid content type specified');\n}\n\nif (request.word_count < 100 || request.word_count > 5000) {\n  request.errors.push('Word count must be between 100 and 5000');\n}\n\nrequest.validated = request.errors.length === 0;\n\nreturn request;"
      }
    },
    {
      "id": "content-type-router",
      "name": "Content Type Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.content_type }}",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.content_type }}",
                    "rightValue": "blog_post",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "blog_post"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.content_type }}",
                    "rightValue": "social_media",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "social_media"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.content_type }}",
                    "rightValue": "email",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.content_type }}",
                    "rightValue": "newsletter",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "newsletter"
            }
          ]
        },
        "fallbackOutput": "single"
      }
    },
    {
      "id": "blog-post-generator",
      "name": "Blog Post Generator",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        700,
        200
      ],
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": "={{ $json.ai_config.model }}",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert content writer specializing in blog posts. Create engaging, informative, and SEO-optimized content that provides real value to readers. Focus on clarity, structure, and actionable insights."
            },
            {
              "role": "user",
              "content": "Topic: {{ $json.topic }}\nWord Count: {{ $json.word_count }}\nTone: {{ $json.tone }}\nStyle: {{ $json.style }}\nTarget Audience: {{ $json.target_audience }}\n\nCreate a comprehensive blog post with:\n1. Compelling headline\n2. Engaging introduction\n3. Well-structured body with subheadings\n4. Practical examples and insights\n5. Strong conclusion with call-to-action\n6. SEO optimization suggestions\n\nMake it informative, engaging, and valuable for the target audience."
            }
          ]
        },
        "options": {
          "temperature": "={{ $json.ai_config.temperature }}",
          "maxTokens": "={{ $json.ai_config.max_tokens }}"
        }
      }
    },
