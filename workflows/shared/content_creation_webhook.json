          "generated_content": "={{ $json.choices ? $json.choices[0].message.content : $json.message || 'No content' }}",
          "optimization_recommendations": "={{ $json.choices ? $json.choices[0].message.content : $json.message || 'No recommendations' }}",
          "word_count": "={{ $node['Content Request Validator'].json['word_count'] }}",
