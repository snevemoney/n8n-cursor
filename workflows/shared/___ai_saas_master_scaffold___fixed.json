    {
      "parameters": {
        "jsCode": "// Enhanced response assembly with error handling\ntry {\n  const items = $input.all();\n  const originalData = items[0]?.json || {};\n  \n  const response = {\n    success: true,\n    requestId: originalData.requestId,\n    action: originalData.action || 'unknown',\n    timestamp: originalData.timestamp || new Date().toISOString(),\n    results: {},\n    errors: []\n  };\n  \n  // Process OpenAI response\n  const openaiResults = $('🤖 OpenAI Chat').all();\n  if (openaiResults.length > 0) {\n    const openaiData = openaiResults[0];\n    if (openaiData.json?.message) {\n      response.results.openai = {\n        success: true,\n        message: openaiData.json.message,\n        model: openaiData.json.model || 'gpt-4o-mini'\n      };\n    } else if (openaiData.error) {\n      response.errors.push({\n        service: 'openai',\n        error: openaiData.error.message || 'Unknown OpenAI error'\n      });\n    }\n  }\n  \n  // Process Supabase response\n  const supabaseResults = $('🗄️ Supabase Insert').all();\n  if (supabaseResults.length > 0) {\n    const supabaseData = supabaseResults[0];\n    if (supabaseData.json && !supabaseData.error) {\n      response.results.supabase = {\n        success: true,\n        status: 'inserted',\n        recordId: supabaseData.json.id || 'unknown'\n      };\n    } else if (supabaseData.error) {\n      response.errors.push({\n        service: 'supabase',\n        error: supabaseData.error.message || 'Unknown Supabase error'\n      });\n    }\n  }\n  \n  // Process Discord response\n  const discordResults = $('💬 Discord Notify').all();\n  if (discordResults.length > 0) {\n    const discordData = discordResults[0];\n    if (discordData.json && !discordData.error) {\n      response.results.discord = {\n        success: true,\n        status: 'notified',\n        messageId: discordData.json.id || 'sent'\n      };\n    } else if (discordData.error) {\n      response.errors.push({\n        service: 'discord',\n        error: discordData.error.message || 'Unknown Discord error'\n      });\n    }\n  }\n  \n  // Set overall success based on errors\n  response.success = response.errors.length === 0;\n  response.totalServices = Object.keys(response.results).length;\n  response.executionTime = Date.now() - new Date(response.timestamp).getTime();\n  \n  return [{ json: response }];\n  \n} catch (error) {\n  return [{\n    json: {\n      success: false,\n      error: 'Response assembly failed: ' + error.message,\n      timestamp: new Date().toISOString()\n    }\n  }];\n}"
      },
