    {
      "parameters": {
        "jsCode": "// Code node (Run once for all items)\n// `items` is an array of incoming items; preserve each and normalize.\nreturn items.map(({ json }) => ({\n  json: {\n    platform: 'twitter',\n    username: json.profile_username || json.username || json[\"Username\"],\n    full_name: json[\"Full Name\"] || null,\n    bio: json.bio || json[\"Bio\"] || null,\n    followers: json.Followers ?? null,\n    following: json.Following ?? null,\n    profile_pic_url: json[\"Profile Pic URL\"] || null,\n    website: json.Website || null,\n    profile_url: json.profile_url || json[\"Twitter link \"] || (\n      (json.profile_username || json.username || json[\"Username\"])\n        ? `https://x.com/${json.profile_username || json.username || json[\"Username\"]}`\n        : null\n    )\n  }\n}));\n"
      },
