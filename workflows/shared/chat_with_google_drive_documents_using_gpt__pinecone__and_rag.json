      "position": [
        3280,
        992
      ],
      "typeVersion": 1.6
    },
    {
      "parameters": {
        "jsCode": "// Keep only what the next node needs and guard for PDFs\nconst items = $input.all();\nreturn items.map(i => {\n  const j = i.json || {};\n  return {\n    json: {\n      id: j.id,                    // used by Download node: {{$json.id}}\n      name: j.name || 'document.pdf',\n      mimeType: j.mimeType\n    }\n  };\n});\n"
      },
