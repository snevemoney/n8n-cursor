    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tenant_assets (\n  tenant_id, \n  asset_type, \n  asset_name, \n  asset_category, \n  location, \n  purchase_date, \n  purchase_price, \n  current_value, \n  condition_status, \n  status, \n  manufacturer, \n  model, \n  serial_number\n) VALUES (\n  '{{ $json.body.tenantId }}', \n  '{{ $json.body.assetType }}', \n  '{{ $json.body.assetName }}', \n  '{{ $json.body.assetCategory }}', \n  '{\"address\":\"{{ $json.body.location }}\"}'::jsonb, \n  '{{ $json.body.purchaseDate }}'::timestamptz, \n  {{ $json.body.purchasePrice }}::numeric, \n  {{ $json.body.currentValue }}::numeric, \n  '{{ $json.body.conditionStatus }}', \n  '{{ $json.body.status }}', \n  '{{ $json.body.manufacturer || \"\" }}', \n  '{{ $json.body.model || \"\" }}', \n  '{{ $json.body.serialNumber || \"\" }}'\n) RETURNING *;",
        "options": {}
      },
