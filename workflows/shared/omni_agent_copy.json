        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"start_date\": {\n      \"type\": \"string\",\n      \"description\": \"Formatted start date in 'YYYY-MM-DD HH:mm:ss' format. This should be midnight (00:00:00) of the day the user wants to book. Always assume the year is 2025. Adjust using the user's IANA timezone (e.g., 'America/New_York'). If no valid date is mentioned, return an empty string.\"\n    },\n    \"end_date\": {\n      \"type\": \"string\",\n      \"description\": \"Formatted end date in 'YYYY-MM-DD HH:mm:ss' format. This should be midnight (00:00:00) of the day after the user wants to book. Always assume the year is 2025. Adjust using the user's IANA timezone (e.g., 'America/New_York'). If no valid date is mentioned, return an empty string.\"\n    }\n  },\n  \"required\": [\"start_date\", \"end_date\"]\n}",
        "options": {
          "systemPromptTemplate": "=Extract the date from the user's input and return a start and end datetime string in 'YYYY-MM-DD HH:mm:ss' format, adjusted for the user's IANA timezone (e.g., \"America/New_York\").\n\nAlways assume the year is 2025, even if not mentioned.\n\nIgnore the specific time in the input (e.g., \"12pm\", \"2:30pm\").\n\nSet:\n\nstart_date to midnight (00:00:00) of the mentioned date\n\nend_date to midnight of the following day (00:00:00)\n\nIf the date is missing, return an empty string."
        }
