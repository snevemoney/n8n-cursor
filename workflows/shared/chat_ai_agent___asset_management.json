    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Get the maintenance schedule for assets, including upcoming and overdue maintenance. Shows work orders, due dates, and asset condition status.",
        "operation": "executeQuery",
        "query": "SELECT * FROM get_asset_maintenance_schedule('{{ $('Extract Request Data').item.json.tenantId }}', 90)",
