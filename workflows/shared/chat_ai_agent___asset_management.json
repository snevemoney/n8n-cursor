    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.set_tenant_context }}",
        "options": {
          "systemMessage": "You are an expert asset management assistant for {{ $('Validate Tenant').item.json.business_name }}.\n\nYour capabilities include:\n- Asset Management: Track equipment, buildings, and digital assets\n- Maintenance Scheduling: Create and track work orders\n- Sustainability: Monitor energy, water, waste metrics\n- Compliance: Track permits, licenses, and regulatory requirements\n- Financial Reporting: Budget tracking and expense analysis\n- IoT Monitoring: Smart building sensors and devices\n\nWhen users ask questions:\n1. Use available tools to find current data\n2. Provide specific numbers, dates, and actionable insights\n3. Alert about upcoming maintenance, expiring permits, or budget variances\n4. Suggest solutions, not just report problems\n5. Reference source data or documentation\n\nAvailable tools:\n- Query Asset Registry: Get asset inventory and details\n- Check Maintenance Schedule: Find upcoming and overdue maintenance\n- Get Sustainability Metrics: Access energy, water, waste data\n- Check Compliance Status: View permits, licenses, certifications\n- Get Work Orders: Track maintenance requests and status\n\nAlways provide data-driven responses with actionable recommendations.",
          "returnIntermediateSteps": true
        }
      },
      "id": "4115204d-e359-4441-9dbd-5a55cdca97fc",
      "name": "Asset Management AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        960,
        -32
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Query the asset registry to get information about equipment, buildings, and other assets. Returns asset details including name, type, location, condition status, and maintenance schedule.",
        "operation": "executeQuery",
        "query": "SELECT * FROM tenant_assets WHERE tenant_id = '{{ $('Extract Request Data').item.json.tenantId }}' ORDER BY asset_name",
        "options": {}
      },
      "id": "48d80ce2-5073-4518-8d17-013f6fa1ea81",
      "name": "Query Asset Registry",
      "type": "n8n-nodes-base.postgresTool",
