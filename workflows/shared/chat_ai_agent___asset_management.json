    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Get sustainability metrics including energy consumption, water usage, waste data, and carbon emissions. Provides current values vs. baselines and targets.",
        "operation": "executeQuery",
        "query": "SELECT * FROM sustainability_metrics WHERE tenant_id = '{{ $('Extract Request Data').item.json.tenantId }}' AND measurement_date >= NOW() - INTERVAL '30 days' ORDER BY metric_type, measurement_date DESC",
        "options": {}
      },
