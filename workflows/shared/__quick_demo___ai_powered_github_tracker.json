  "name": "⚡ Quick Demo - AI-Powered GitHub Tracker",
  "active": false,
  "isArchived": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Monitor Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "owner": "microsoft",
        "repository": "vscode",
        "resource": "issue",
        "operation": "getAll",
        "returnAll": false,
        "limit": 5,
        "additionalFields": {
          "state": "open",
          "sort": "updated"
        }
      },
      "id": "github-issues",
      "name": "📋 Latest VS Code Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "credentials": {
        "githubOAuth2Api": {
          "id": "7AHIs1rB5eD37AtE",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-3.5-turbo",
        "messages": {
          "messageValues": [
            {
              "message": "=Analyze this GitHub issue and provide insights:\n\nTitle: {{ $json.title }}\nBody: {{ $json.body }}\nLabels: {{ $json.labels.map(l => l.name).join(', ') }}\nState: {{ $json.state }}\nCreated: {{ $json.created_at }}\n\nProvide a JSON response with:\n{\n  \"priority\": \"high/medium/low\",\n  \"category\": \"bug/feature/documentation/other\",\n  \"complexity\": \"simple/moderate/complex\",\n  \"summary\": \"one sentence summary\",\n  \"action_needed\": \"what should be done\",\n  \"urgency_score\": (1-10)\n}"
            }
          ]
        }
      },
      "id": "ai-analysis",
      "name": "🤖 AI Issue Analyzer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        680,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "lZKgMC5gqvEU7qus",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "high-priority",
              "leftValue": "={{ JSON.parse($json.choices[0].message.content).urgency_score }}",
              "rightValue": 7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "priority-filter",
      "name": "🚨 High Priority Filter",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "postToChannel",
        "channel": {
          "__rl": true,
          "value": "general",
          "mode": "name"
        },
        "text": "=🚨 **HIGH PRIORITY GITHUB ISSUE DETECTED!**\\n\\n📋 **{{ $('📋 Latest VS Code Issues').first().json.title }}**\\n\\n🤖 **AI Analysis:**\\n{{ JSON.parse($json.choices[0].message.content).summary }}\\n\\n📊 **Details:**\\n• Priority: {{ JSON.parse($json.choices[0].message.content).priority }}\\n• Category: {{ JSON.parse($json.choices[0].message.content).category }}\\n• Urgency Score: {{ JSON.parse($json.choices[0].message.content).urgency_score }}/10\\n• Complexity: {{ JSON.parse($json.choices[0].message.content).complexity }}\\n\\n💡 **Recommended Action:**\\n{{ JSON.parse($json.choices[0].message.content).action_needed }}\\n\\n🔗 **GitHub Link:** {{ $('📋 Latest VS Code Issues').first().json.html_url }}\\n\\n#GitHub #VSCode #DevOps",
        "otherOptions": {}
      },
      "id": "slack-alert",
      "name": "📢 Priority Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
