    {
      "parameters": {
        "jsCode": "// Route to different email types based on body.type\nconst emailType = $input.item.json.body?.type || 'generic';\n\n// Map email types to templates\nconst templateMap = {\n  'welcome': 'welcome_email',\n  'verification': 'verification_email',\n  'password-reset': 'password_reset_email',\n  'work-order': 'work_order_notification',\n  'compliance-alert': 'compliance_alert_email',\n  'monthly-report': 'monthly_report_email'\n};\n\nreturn {\n  json: {\n    emailType,\n    template: templateMap[emailType] || 'generic_email',\n    recipient: $input.item.json.body?.recipient,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "cb0fbe9f-1a4c-4686-b1ce-7e35400f5d0d",
      "name": "Route Email Type",
