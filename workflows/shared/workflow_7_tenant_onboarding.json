      "position": [0, 400],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO knowledge_base_files (tenant_id, topic_name, file_name, file_size, mime_type, uploaded_at) VALUES ('{{ $('Extract Onboarding Data').item.json.tenantId }}', 'Getting Started', 'Welcome Guide.pdf', 0, 'application/pdf', NOW()), ('{{ $('Extract Onboarding Data').item.json.tenantId }}', 'Account & Billing', 'Billing Information.pdf', 0, 'application/pdf', NOW()), ('{{ $('Extract Onboarding Data').item.json.tenantId }}', 'FAQs', 'Common Questions.pdf', 0, 'application/pdf', NOW())",
        "options": {}
      },
      "id": "create-categories",
      "name": "Create Default KB Categories",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [200, 400],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
