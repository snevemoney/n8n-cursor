        "query": "INSERT INTO compliance_records (tenant_id, record_type, document_name, issuing_authority, expiry_date, status)\nVALUES (\n  'test-tenant-webhook-validation',\n  'license',\n  'Test License',\n  'Test Authority',\n  CURRENT_DATE + INTERVAL '7 days', -- Expires in 7 days\n  'current'\n);",
        "options": {}
