    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  t.admin_email,\n  COALESCE(c.document_name, 'Compliance Alert') as document_name,\n  COALESCE(c.expiry_date, CURRENT_DATE + 30) as expiry_date,\n  COALESCE(c.days_until_expiry, 30) as days_until_expiry,\n  COALESCE(c.record_type, 'General') as record_type,\n  COALESCE(c.issuing_authority, 'N/A') as issuing_authority\nFROM tenants t\nLEFT JOIN LATERAL (\n  SELECT * FROM get_expiring_compliance('{{ $node[\"Split In Batches\"].json.tenant_id }}', 30) LIMIT 1\n) c ON true\nWHERE t.tenant_id = '{{ $node[\"Split In Batches\"].json.tenant_id }}'",
        "options": {}
      },
