              "leftValue": "={{ $json.featureType }}",
              "rightValue": "data-export",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "3359e014-f85a-480f-9181-a02195621864",
      "name": "Route by Feature Type",
      "type": "n8n-nodes-base.if",
