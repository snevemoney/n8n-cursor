    {
      "parameters": {
        "jsCode": "// Route to different advanced features\nconst featureType = $input.item.json.body?.type || 'multi-language';\n\nreturn {\n  json: {\n    featureType,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "ad01eaf0-5917-4b9d-a4bc-110f0295f0c8",
      "name": "Route Feature Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -704,
        400
      ]
    },
    {
      "parameters": {
