              "id": "multi-lang-condition",
              "leftValue": "={{ $json.featureType }}",
              "rightValue": "multi-language",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ocr-condition",
              "leftValue": "={{ $json.featureType }}",
              "rightValue": "ocr",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "content-extract-condition",
              "leftValue": "={{ $json.featureType }}",
              "rightValue": "content-extract",
              "operator": {
