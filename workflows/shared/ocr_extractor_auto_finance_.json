    {
      "parameters": {
        "jsCode": "// INPUT: Google Sheets \"Get rows\" gives rows with keys like:\n// { row_number: \"2\", agreement_type: \"Auto Loan\", governing_law: \"State of Illinois\", ... }\n\nconst rows = $input.all();\n\n// Merge all rows into a single object\nlet data = {};\nfor (const row of rows) {\n  Object.assign(data, row.json);\n}\n\n// Remove helper columns you don't want\ndelete data.row_number;\n\nconst system = \"You are a loan-agreement analysis assistant. Return a plain text report with these sections:\\n1. Executive Summary\\n2. Loan Breakdown\\n3. Borrower & Lender Analysis\\n4. Observations & Risks\\n5. Recommendations\";\n\nconst user = \"Data (attribute → value):\\n\" + JSON.stringify(data, null, 2);\n\nreturn [{\n  json: {\n    messages: [\n      { role: \"system\", content: system },\n      { role: \"user\", content: user }\n    ],\n    data\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
