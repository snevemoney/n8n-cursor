    {
      "parameters": {
        "jsCode": "// Route to different auth operations based on body.action\nconst action = $input.item.json.body?.action || 'unknown';\n\n// Map actions to routes\nconst routeMap = {\n  'signup': '/auth/signup',\n  'login': '/auth/login',\n  'logout': '/auth/logout',\n  'refresh': '/auth/refresh',\n  'verify-email': '/auth/verify-email',\n  'reset-password-request': '/password/reset-request',\n  'reset-password-complete': '/password/reset-complete',\n  'change-password': '/password/change'\n};\n\nreturn {\n  json: {\n    action,\n    route: routeMap[action] || '/auth/login',\n    payload: $input.item.json.body\n  }\n};"
      },
      "id": "c21c2899-a804-41e7-90ac-39090a7e119e",
      "name": "Route Auth Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -768,
        336
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "signup-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "signup",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "login-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "login",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "logout-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "logout",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "refresh-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "refresh",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "0e4bcb44-ddeb-4487-b2ba-5bbbe1ad342a",
