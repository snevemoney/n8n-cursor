    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO work_orders (tenant_id, asset_id, title, description, priority, status, requested_by, scheduled_date, due_date) VALUES ('{{ $json.tenantId }}', {{ $json.assetId }}, '{{ $json.title }}', '{{ $json.description }}', '{{ $json.priority }}', 'pending', '{{ $json.requestedBy }}', '{{ $json.scheduledDate }}', '{{ $json.dueDate }}') RETURNING *",
        "options": {}
      },
      "id": "create-order",
      "name": "Create Work Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-400, 400],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT wo.*, ta.asset_name, ta.asset_category, v.vendor_name FROM work_orders wo LEFT JOIN tenant_assets ta ON wo.asset_id = ta.id LEFT JOIN vendors v ON wo.vendor_id = v.id WHERE wo.tenant_id = '{{ $json.tenantId }}' ORDER BY wo.created_at DESC",
        "options": {}
      },
      "id": "get-orders",
      "name": "Get Work Orders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-400, 500],
      "credentials": {
        "postgres": {
          "id": "qKFQKlLBm0LkPAxq",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE work_orders SET status = '{{ $json.status }}', completed_date = CASE WHEN '{{ $json.status }}' = 'completed' THEN NOW() ELSE completed_date END, resolution_notes = '{{ $json.resolutionNotes }}', updated_at = NOW() WHERE id = {{ $('PUT /work-orders/:orderId/... Webhook').item.json.pathParameters.orderId }} RETURNING *",
        "options": {}
      },
      "id": "update-status",
      "name": "Update Work Order Status",
