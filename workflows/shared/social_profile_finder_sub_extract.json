    },
    {
      "parameters": {
        "jsCode": "// Make wasUrl true whenever we end up with a usable profileUrl\nconst cleanHandle = (s) => String(s || \"\").trim().replace(/^@+/, \"\");\n\nconst buildUrl = (platform, username) => {\n  const u = cleanHandle(username);\n  switch (String(platform || \"\").toLowerCase()) {\n    case \"instagram\": return `https://www.instagram.com/${u}/`;\n    case \"twitter\":   return `https://twitter.com/${u}`;\n    case \"tiktok\":    return `https://www.tiktok.com/@${u}`;\n    case \"facebook\":  return `https://www.facebook.com/${u}`;\n    case \"linkedin\":  return `https://www.linkedin.com/in/${u}/`;\n    default:          return \"\";\n  }\n};\n\nconst isUrl = (s) => {\n  try { new URL(String(s || \"\")); return true; } catch { return false; }\n};\n\nfunction normalize(input, platform) {\n  const raw = String(input || \"\").trim();\n  const pf  = String(platform || \"\").toLowerCase();\n\n  const out = {\n    inputRaw: raw,\n    platform: pf,\n    wasUrl: false,\n    username: \"\",\n    profileUrl: \"\"\n  };\n\n  if (!raw) return out;\n\n  if (isUrl(raw)) {\n    // User provided a URL\n    out.profileUrl = raw;\n    try {\n      const url = new URL(raw);\n      const parts = url.pathname.split(\"/\").filter(Boolean);\n      if (pf === \"tiktok\") {\n        const first = parts[0] || \"\";\n        out.username = cleanHandle(first.startsWith(\"@\") ? first.slice(1) : first);\n      } else if (pf === \"linkedin\") {\n        const m = url.pathname.match(/^\\/(?:in|company|school|showcase)\\/([^\\/?#]+)/i);\n        out.username = cleanHandle(m ? m[1] : (parts[0] || \"\"));\n      } else {\n        out.username = cleanHandle(parts[0] || \"\");\n      }\n    } catch {}\n    out.wasUrl = true; // we received a valid URL\n  } else {\n    // User provided a handle — construct the URL for this platform\n    out.username = cleanHandle(raw);\n    out.profileUrl = buildUrl(pf, out.username);\n    out.wasUrl = !!out.profileUrl; // mark true because we created a usable URL\n  }\n\n  return out;\n}\n\n// --- main ---\nconst input = $json[\"profile username OR profile URL\"];\nconst platform = $json.platform;\n\nreturn [ normalize(input, platform) ];\n"
      },
