{
  "name": "API Key Management System",
  "nodes": [
    {
      "parameters": {
        "path": "/api-keys",
        "httpMethod": "POST"
      },
      "id": "api-key-webhook-entry",
      "name": "API Key Entry Point",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different API key operations\nconst apiKeyAction = $input.item.json.body?.action || 'create';\n\nreturn {\n  json: {\n    action: apiKeyAction,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "route-api-key-action",
      "name": "Route API Key Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "create-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "create",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "revoke-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "revoke",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "validate-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "validate",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "throttle-condition",
              "leftValue": "={{ $json.action }}",
              "rightValue": "throttle",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-api-key-action",
      "name": "Route by API Key Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate and create API key using n8n built-in crypto\nconst chars = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';\nconst apiKey = Array.from({length: 64}, () => chars[Math.floor(Math.random() * chars.length)]).join('');\n\n// Hash using n8n built-in hash function\nconst hashedKey = $hash($json.data.tenantId + apiKey, {algorithm: 'sha256'});\n\nreturn {\n  json: {\n    apiKey,\n    hashedKey,\n    tenantId: $json.data.tenantId,\n    permissions: $json.data.permissions || ['read', 'write']\n  }\n};"
      },
      "id": "create-api-key",
      "name": "Create API Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE api_keys SET revoked = true, revoked_at = NOW() WHERE id = $1;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.apiKeyId}` }}"
        }
      },
      "id": "revoke-api-key",
      "name": "Revoke API Key",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM api_keys WHERE hashed_key = $1 AND revoked = false;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": crypto.createHash('sha256').update($json.data.apiKey).digest('hex')}` }}"
        }
      },
      "id": "validate-api-key",
      "name": "Validate API Key",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as request_count FROM rate_limits WHERE api_key_id = $1 AND created_at > NOW() - INTERVAL '1 minute';",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.apiKeyId}` }}"
        }
      },
      "id": "check-throttle",
      "name": "Check Throttling",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-api-key",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
