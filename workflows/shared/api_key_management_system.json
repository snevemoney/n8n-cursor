    {
      "parameters": {
        "jsCode": "// Generate and create API key\nconst crypto = require('crypto');\nconst apiKey = crypto.randomBytes(32).toString('hex');\nconst hashedKey = crypto.createHash('sha256').update(apiKey).digest('hex');\n\nreturn {\n  json: {\n    apiKey,\n    hashedKey,\n    tenantId: $json.data.tenantId,\n    permissions: $json.data.permissions || ['read', 'write']\n  }\n};"
      },
      "id": "8a2c429e-dc98-4522-bccf-858e0ad19d13",
      "name": "Create API Key",
