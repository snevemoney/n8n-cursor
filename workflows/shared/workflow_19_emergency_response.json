{
  "name": "Emergency Response System",
  "nodes": [
    {
      "parameters": {
        "path": "/emergency",
        "httpMethod": "POST"
      },
      "id": "emergency-webhook-entry",
      "name": "Emergency Entry Point",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different emergency operations\nconst emergencyType = $input.item.json.body?.type || 'incident';\n\nreturn {\n  json: {\n    emergencyType,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "route-emergency-type",
      "name": "Route Emergency Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "incident-condition",
              "leftValue": "={{ $json.emergencyType }}",
              "rightValue": "incident",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "escalate-condition",
              "leftValue": "={{ $json.emergencyType }}",
              "rightValue": "escalate",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "restore-condition",
              "leftValue": "={{ $json.emergencyType }}",
              "rightValue": "restore",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "report-condition",
              "leftValue": "={{ $json.emergencyType }}",
              "rightValue": "report",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-emergency-type",
      "name": "Route by Emergency Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Detect and log incident\nconst incident = {\n  id: crypto.randomUUID(),\n  type: $json.data.type,\n  severity: $json.data.severity || 'medium',\n  detectedAt: new Date().toISOString(),\n  affectedServices: $json.data.affectedServices || [],\n  description: $json.data.description\n};\n\nreturn {\n  json: {\n    incident,\n    requiresEscalation: incident.severity === 'critical' || incident.severity === 'high'\n  }\n};"
      },
      "id": "detect-incident",
      "name": "Detect Incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO incidents (incident_id, type, severity, description, status)\nVALUES ($1, $2, $3, $4, 'open')\nRETURNING *;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.incident.id, \"$2\": $json.incident.type, \"$3\": $json.incident.severity, \"$4\": $json.incident.description}` }}"
        }
      },
      "id": "escalate-incident",
      "name": "Escalate Incident",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "// Restore service\nconst restoration = {\n  action: 'restore',\n  service: $json.data.serviceName,\n  method: 'auto',\n  fallback: true,\n  rollback: false\n};\n\nreturn {\n  json: {\n    restoration,\n    status: 'in-progress',\n    estimatedTime: '5-15 minutes'\n  }\n};"
      },
      "id": "restore-service",
      "name": "Restore Service",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  incident_id,\n  type,\n  severity,\n  description,\n  status,\n  created_at,\n  resolved_at\nFROM incidents\nWHERE tenant_id = $1\nORDER BY created_at DESC\nLIMIT 10;",
        "additionalFields": {
          "queryParameters": "={{ `{\"$1\": $json.data.tenantId}` }}"
        }
      },
      "id": "generate-incident-report",
      "name": "Generate Incident Report",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, data: $json, timestamp: new Date().toISOString() } }}"
      },
      "id": "respond-emergency",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
