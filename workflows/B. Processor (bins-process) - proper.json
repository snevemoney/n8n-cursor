      "typeVersion": 2,
      "position": [460, 200],
      "parameters": {
        "propertyName": "bin",
        "rules": {
          "values": [
            {
              "operation": "equal",
              "value": "CONTRACT"
            },
            {
              "operation": "equal",
              "value": "BANKING"
