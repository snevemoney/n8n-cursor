    {
      "id": "Merge_Values",
      "name": "Merge (take extractor result)",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [960, 300],
      "parameters": {
        "mode": "passThrough"
      }
    },
    {
      "id": "Code_ValuesToRows",
      "name": "Code: values → rows",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [1180, 300],
      "parameters": {
        "functionCode": "// Convert {values} → rows for Update Rows\nconst vals = $json.values || {};\nconst rows = Object.entries(vals)\n  .filter(([k,v]) => (v ?? '') !== '')\n  .map(([k,v]) => ({ json: { Attribute: k, output: String(v) } }));\nreturn rows.length ? rows : [{ json: { Attribute: '__noop__', output: '' } }];"
      }
    },
    {
      "id": "Sheets_UpdateRows",
      "name": "Google Sheets: Update Rows (Key = Attribute)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 5,
      "position": [1400, 300],
      "parameters": {
        "operation": "update",
        "sheetId": "GOOGLE_SHEET_ID",
        "range": "LOAN_AGREEMENT_ATTRIBUTES!A:C",
        "key": "Attribute",
        "options": {
          "valueInputMode": "RAW",
          "continueOnFail": true
        },
        "columns": [
          "Attribute",
          "output"
        ]
      }
    },
    {
      "id": "Webhook_Response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1640, 300],
      "parameters": {
        "responseBody": "={ { job_id: $json.job_id || 'unknown', status: 'processed', attributes_written: $items().length } }",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
