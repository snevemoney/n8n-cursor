{
  "name": "Hive CE Lead Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hive-ce-lead",
        "options": {
          "responseMode": "responseNode"
        }
      },
      "id": "webhook-trigger",
      "name": "CE Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 400],
      "webhookId": "hive-ce-lead"
    },
    {
      "parameters": {
        "jsCode": "// Build CE Lead alert message\nconst body = $json.body || $json;\n\nconst leadId = body.leadId || body.id || `lead_${Date.now()}`;\nconst source = body.source || 'unknown';\nconst name = body.name || body.leadName || 'Anonymous';\nconst email = body.email || 'N/A';\nconst score = body.score || body.leadScore || 0;\nconst channel = body.channel || 'direct';\nconst notes = body.notes || body.message || '';\n\nconst text = [\n  `🎯 NEW CE LEAD`,\n  ``,\n  `Lead: ${name}`,\n  `Email: ${email}`,\n  `Score: ${score}`,\n  `Source: ${source}`,\n  `Channel: ${channel}`,\n  notes ? `Notes: ${notes}` : '',\n  ``,\n  `ID: ${leadId}`,\n  `Time: ${new Date().toISOString()}`\n].filter(Boolean).join('\\n');\n\nreturn [{ json: { text, leadId, name, score } }];"
      },
      "id": "build-alert",
      "name": "Build Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "jsCode": "// Preflight: verify TELEGRAM_BOT_TOKEN is configured\nconst token = $env.TELEGRAM_BOT_TOKEN;\nif (!token || token === '' || token === 'undefined' || token === 'null') {\n  return [{\n    json: {\n      sent: false,\n      error: 'TELEGRAM_BOT_TOKEN is not set or empty. This causes HTTP 404 from Telegram API.',\n      hint: 'Operator: Set TELEGRAM_BOT_TOKEN in n8n Settings > Variables. The token format is 123456789:ABCdefGHI...',\n      originalMessage: $json.text\n    }\n  }];\n}\n\nconst chatId = $env.HIVE_CE_LEAD_CHAT_ID || $env.HIVE_TELEGRAM_CHAT_ID;\nif (!chatId) {\n  return [{\n    json: {\n      sent: false,\n      error: 'HIVE_CE_LEAD_CHAT_ID (or HIVE_TELEGRAM_CHAT_ID) is not set.',\n      hint: 'Operator: Set the chat_id env var in n8n Settings > Variables.',\n      originalMessage: $json.text\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...$json,\n    _telegram: { token, chatId, ready: true }\n  }\n}];"
      },
      "id": "telegram-preflight",
      "name": "Telegram Preflight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ready-check",
              "leftValue": "={{ $json._telegram?.ready }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "token-check",
      "name": "Token Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [950, 400]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $json._telegram.token }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json._telegram.chatId }}\",\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "telegram-alert",
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"received\": true,\n  \"leadId\": \"{{ $json.leadId || '' }}\",\n  \"notified\": {{ $json._telegram?.ready || false }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-skipped",
      "name": "Respond Skipped",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 550]
    }
  ],
  "connections": {
    "CE Lead Webhook": {
      "main": [
        [
          { "node": "Build Alert", "type": "main", "index": 0 }
        ]
      ]
    },
    "Build Alert": {
      "main": [
        [
          { "node": "Telegram Preflight", "type": "main", "index": 0 }
        ]
      ]
    },
    "Telegram Preflight": {
      "main": [
        [
          { "node": "Token Ready?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Token Ready?": {
      "main": [
        [
          { "node": "Telegram Alert", "type": "main", "index": 0 }
        ],
        [
          { "node": "Respond Skipped", "type": "main", "index": 0 }
        ]
      ]
    },
    "Telegram Alert": {
      "main": [
        [
          { "node": "Respond OK", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "id": "131918c7-1ca3-4205-8d42-cfc802c19a30",
  "meta": {
    "instanceId": "hive-ops"
  },
  "tags": [
    { "name": "hive" },
    { "name": "ce-lead" },
    { "name": "telegram" },
    { "name": "priority-1" }
  ]
}
