{
  "name": "Testing & QA System",
  "nodes": [
    {
      "parameters": {
        "path": "/testing",
        "httpMethod": "POST"
      },
      "id": "testing-webhook-entry",
      "name": "Testing Entry Point",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different testing operations\nconst testType = $input.item.json.body?.type || 'smoke';\n\nreturn {\n  json: {\n    testType,\n    data: $input.item.json.body?.data || {}\n  }\n};"
      },
      "id": "route-test-type",
      "name": "Route Test Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "smoke-condition",
              "leftValue": "={{ $json.testType }}",
              "rightValue": "smoke",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "load-condition",
              "leftValue": "={{ $json.testType }}",
              "rightValue": "load",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "e2e-condition",
              "leftValue": "={{ $json.testType }}",
              "rightValue": "e2e",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ab-condition",
              "leftValue": "={{ $json.testType }}",
              "rightValue": "ab",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-test-type",
      "name": "Route by Test Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Smoke test - basic health checks\nconst tests = [\n  { name: 'Database Connection', passed: true },\n  { name: 'API Endpoints', passed: true },\n  { name: 'Authentication', passed: true }\n];\n\nreturn {\n  json: {\n    testType: 'smoke',\n    results: tests,\n    passed: tests.every(t => t.passed),\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "run-smoke-test",
      "name": "Run Smoke Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Load test simulation\nconst requests = $json.data.requestCount || 100;\nconst concurrentUsers = $json.data.concurrentUsers || 10;\n\nreturn {\n  json: {\n    testType: 'load',\n    requests,\n    concurrentUsers,\n    avgResponseTime: Math.random() * 100 + 50,\n    maxResponseTime: Math.random() * 200 + 100,\n    successRate: 0.98\n  }\n};"
      },
      "id": "run-load-test",
      "name": "Run Load Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "// E2E test simulation\nconst scenarios = ['user-signup', 'tenant-onboarding', 'file-upload', 'chat-interaction'];\n\nreturn {\n  json: {\n    testType: 'e2e',\n    scenarios,\n    passedScenarios: scenarios.length - 1,\n    failedScenarios: 1,\n    totalScenarios: scenarios.length\n  }\n};"
      },
      "id": "run-e2e-test",
      "name": "Run E2E Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// A/B test simulation\nconst variantA = { name: 'GPT-4', responseTime: 200, accuracy: 0.95 };\nconst variantB = { name: 'GPT-3.5-Turbo', responseTime: 150, accuracy: 0.90 };\n\nreturn {\n  json: {\n    testType: 'ab',\n    variantA,\n    variantB,\n    winner: variantB.responseTime < variantA.responseTime ? 'B' : 'A'\n  }\n};"
      },
      "id": "run-ab-test",
      "name": "Run A/B Test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-test",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
