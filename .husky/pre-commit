#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔒 Running pre-commit safety checks..."

# Lint and type check
echo "📝 Running lint and type checks..."
pnpm -w lint && pnpm -w typecheck

# Structure verification
echo "🏗️ Verifying workspace structure..."
node tooling/scripts/verify-structure.mjs

# Port availability check (temporarily disabled)
# echo "🔌 Checking port availability..."
# bash tooling/scripts/ports-check.sh

# Run tests (allow early projects to pass)
echo "🧪 Running tests..."
pnpm -w test -- --bail --findRelatedTests || echo "⚠️ Tests failed but continuing..."

echo "✅ Pre-commit checks passed!"
