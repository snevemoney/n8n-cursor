{
  "name": "@lightningflow/contracts",
  "version": "1.0.0",
  "description": "Generated types and validators from LightningFlow AI contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "npm run generate:openapi && npm run generate:events && npm run generate:flags && npm run generate:errors && npm run generate:telemetry",
    "generate:openapi": "openapi-typescript ../../contracts/openapi.yaml -o src/openapi.d.ts",
    "generate:events": "node scripts/generate-events.js",
    "generate:flags": "node scripts/generate-flags.js",
    "generate:errors": "node scripts/generate-errors.js",
    "generate:telemetry": "node scripts/generate-telemetry.js",
    "validate": "npm run validate:openapi && npm run validate:events && npm run validate:flags && npm run validate:errors && npm run validate:telemetry",
    "validate:openapi": "node scripts/validate-openapi.cjs",
    "validate:events": "node scripts/validate-events.cjs",
    "validate:flags": "node scripts/validate-flags.cjs",
    "validate:errors": "node scripts/validate-errors.cjs && node scripts/check-error-parity.cjs",
    "validate:telemetry": "node scripts/validate-telemetry.cjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test:errors": "node tests/errors.cjs",
    "test:exports": "node tests/exports.cjs",
    "test:validation": "node tests/validation.cjs",
    "test:events": "node tests/events.cjs",
    "test:schema": "node tests/schema.cjs",
    "test:objects": "node tests/objects.cjs",
    "test:flags": "node tests/flags.cjs",
    "test:time": "node tests/time.cjs",
    "test:event-schema": "node tests/event-schema.cjs",
    "test:flag-schema": "node tests/flag-schema.cjs"
  },
  "keywords": [
    "lightningflow",
    "contracts",
    "types",
    "validators",
    "openapi",
    "bitcoin",
    "lightning"
  ],
  "author": "LightningFlow AI",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-errors": "^3.0.0",
    "luxon": "3.7.2",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "openapi-typescript": "^6.0.0",
    "swagger-jsdoc": "^6.0.0",
    "typescript": "^5.0.0",
    "@types/luxon": "3.7.1",
    "js-yaml": "4.1.0",
    "swagger-parser": "10.0.3"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
