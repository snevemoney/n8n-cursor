{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-state",
  "title": "Typed hive state (filter one key; do not dump)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ids", "profile", "jobs", "last_run", "log", "product_factory"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monotonic", "next_run_id"],
      "properties": {
        "monotonic": { "type": "boolean", "const": true },
        "next_run_id": { "type": "integer", "minimum": 1 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "stack", "clients", "hard_step"],
      "properties": {
        "operator": { "type": "string" },
        "stack": {
          "type": "array",
          "items": { "type": "string", "enum": ["cursor", "grok"] }
        },
        "clients": { "type": "string", "enum": ["parked", "named"] },
        "hard_step": { "type": "string", "enum": ["hitl"] }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "desk", "updated"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "working",
              "yellow",
              "done",
              "IMPLEMENTED",
              "BEHAVIOR_PASS",
              "RECEIPT_UNPROVEN",
              "VERIFYING",
              "BLOCKED",
              "PARTIAL",
              "DONE",
              "PASS",
              "VERIFIED",
              "LIVE",
              "SHIPPED",
              "CLOSED"
            ]
          },
          "desk": { "type": "string" },
          "updated": { "type": "string" },
          "note": { "type": "string" },
          "owner": { "type": "string" },
          "expected_artifact": { "type": "string" },
          "wake_condition": { "type": "string" },
          "stall_timeout": { "type": "string" },
          "builder": { "type": "string" },
          "proofPermit": { "type": "string" },
          "terminal_rejected": { "type": "string" },
          "closes_work": { "type": "boolean" },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array" },
          "verifier": { "type": "object" },
          "environment": { "type": "object" },
          "session": { "type": "object" },
          "receipt": { "type": "object" }
        }
      }
    },
    "last_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "job", "desk", "at"],
      "properties": {
        "id": { "type": ["integer", "null"] },
        "job": { "type": ["string", "null"] },
        "desk": { "type": ["string", "null"] },
        "at": { "type": ["string", "null"] },
        "done_check": { "type": ["string", "null"] },
        "stop_kind": { "type": ["string", "null"] },
        "token_receipt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokens": { "type": ["integer", "string", "null"] },
            "duration": { "type": ["string", "null"] },
            "correctness": {
              "type": ["string", "null"],
              "enum": ["pass", "fail", "untested", null]
            }
          }
        }
      }
    },
    "product_factory": {
      "type": "object",
      "description": "Pointer only. Filter this key. Do not dump the bank.",
      "additionalProperties": false,
      "required": ["primitives", "roadblocks", "promotion"],
      "properties": {
        "primitives": { "type": "string" },
        "roadblocks": { "type": "string" },
        "promotion": { "type": "string" },
        "updated": { "type": "string" }
      }
    },
    "post_fix_cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armed", "adopted", "compare_to_historical_floors", "historical_floors", "counters"],
      "properties": {
        "armed": { "type": "boolean" },
        "adopted": { "type": "boolean" },
        "compare_to_historical_floors": { "type": "boolean" },
        "historical_floors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unsupported_completion_sessions",
            "artifact_only_rows",
            "divergence_instances"
          ],
          "properties": {
            "unsupported_completion_sessions": { "type": "integer", "const": 39 },
            "artifact_only_rows": { "type": "integer", "const": 34 },
            "divergence_instances": { "type": "integer", "const": 18 }
          }
        },
        "counters": { "type": "object" }
      }
    },
    "log": {
      "type": "array",
      "description": "Append-only. Delete a job row ≠ reset next_run_id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "job", "desk", "at"],
        "properties": {
          "id": { "type": "integer" },
          "job": { "type": "string" },
          "desk": { "type": "string" },
          "at": { "type": "string" },
          "done_check": { "type": ["string", "null"] },
          "stop_kind": { "type": ["string", "null"] }
        }
      }
    }
  }
}
