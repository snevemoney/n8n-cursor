{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-knowledge-fragment",
  "title": "Reusable workflow fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["fragment_id", "version", "input", "steps", "output"],
  "properties": {
    "fragment_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "input": { "type": "string" },
    "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "output": { "type": "string" },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "behavior_ids": { "type": "array", "items": { "type": "string" } },
    "valid_when": { "type": "string" },
    "less_relevant_when": { "type": "string" },
    "knowledge_type": {
      "type": "string",
      "enum": ["declared", "demonstrated", "implicit", "synthesis"]
    }
  }
}
