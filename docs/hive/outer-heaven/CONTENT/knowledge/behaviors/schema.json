{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive-knowledge-behavior",
  "title": "Observed behavioral sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "behavior_id",
    "source_video_id",
    "goal",
    "sequence",
    "evidence_status"
  ],
  "properties": {
    "behavior_id": { "type": "string" },
    "source_video_id": { "type": "string" },
    "creator_id": { "type": "string" },
    "goal": { "type": "string" },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "action"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "action": { "type": "string" },
          "tool": { "type": "string" },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "decision": { "type": "string" },
          "timestamp": { "type": "string" },
          "modality": {
            "type": "string",
            "enum": ["speech", "screen", "click", "navigation", "visual", "timing", "failure", "edit-signal"]
          }
        }
      }
    },
    "speech_aligned": { "type": "boolean" },
    "evidence_status": {
      "type": "string",
      "enum": ["observed", "transcript-implied", "unobserved", "UNKNOWN"]
    },
    "occurrence_count_this_creator": { "type": "integer", "minimum": 0 },
    "atom_ids": { "type": "array", "items": { "type": "string" } },
    "failure_branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "goal": { "type": "string" },
          "attempt": { "type": "string" },
          "failure": { "type": "string" },
          "symptom": { "type": "string" },
          "diagnosis": { "type": "string" },
          "correction": { "type": "string" },
          "outcome": { "type": "string" },
          "lesson": { "type": "string" }
        }
      }
    }
  }
}
