# LightningFlow AI Platform - Hardened Caddy Configuration
# Dual domain setup: lightningflow.online + n8ncloud.tech

# Common security headers and settings
(common) {
  encode gzip
  
  # Security headers
  header {
    # HTTPS enforcement
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Content protection
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-XSS-Protection "1; mode=block"
    Referrer-Policy "strict-origin-when-cross-origin"
    
    # Remove server information
    -Server
    -X-Powered-By
    
    # Content Security Policy (tightened for security)
    Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co https://*.lightningflow.online; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
  }
  
  # Rate limiting
  rate_limit {
    zone static {
      key {remote_host}
      events 100
      window 1m
    }
  }
}

# LightningFlow Domain - SaaS UI/API
lightningflow.online, www.lightningflow.online {
  import common
  
  # Health endpoints (no rate limiting for monitoring)
  @health path /healthz
  handle @health {
    respond 200 {
      body "OK"
      header Content-Type "text/plain"
    }
  }
  
  @apihealth path /api/healthz
  handle @apihealth {
    reverse_proxy 127.0.0.1:4000 {
      health_uri /api/healthz
      health_interval 30s
      health_timeout 5s
    }
  }
  
  # API routes
  handle_path /api/* {
    reverse_proxy 127.0.0.1:4000 {
      health_uri /api/healthz
      health_interval 30s
      health_timeout 5s
      
      # API-specific headers
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
      header_up X-Real-IP {remote_host}
    }
  }
  
  # Web UI (everything else)
  handle {
    reverse_proxy 127.0.0.1:3000 {
      health_uri /healthz
      health_interval 30s
      health_timeout 5s
      
      # Web-specific headers
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
      header_up X-Real-IP {remote_host}
    }
  }
}

# Legacy n8n apex (dual-host cutover) — see Caddyfile.evenslouis.prod for live target
n8ncloud.tech, www.n8ncloud.tech {
  import common
  handle /webhook* { reverse_proxy 127.0.0.1:5678 }
  handle /webhook-test* { reverse_proxy 127.0.0.1:5678 }
  handle /rest* { reverse_proxy 127.0.0.1:5678 }
  handle /api* { reverse_proxy 127.0.0.1:5678 }
  @health path /healthz
  handle @health { reverse_proxy 127.0.0.1:5678 }
  handle { redir https://evenslouis.ca/n8n{uri} permanent }
}

# Personal site + n8n under /n8n (strip prefix; proxy absolute editor assets)
evenslouis.ca, www.evenslouis.ca {
  import common
  handle /builder/* { reverse_proxy 127.0.0.1:3001 }
  handle_path /n8n* {
    reverse_proxy 127.0.0.1:5678 {
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
      header_up X-Real-IP {remote_host}
    }
  }
  handle /assets* { reverse_proxy 127.0.0.1:5678 }
  handle /static* { reverse_proxy 127.0.0.1:5678 }
  handle /types* { reverse_proxy 127.0.0.1:5678 }
  handle /rest* { reverse_proxy 127.0.0.1:5678 }
  handle /webhook* { reverse_proxy 127.0.0.1:5678 }
  handle /webhook-test* { reverse_proxy 127.0.0.1:5678 }
  handle /icon* { reverse_proxy 127.0.0.1:5678 }
  handle /favicon.ico { reverse_proxy 127.0.0.1:5678 }
  handle {
    reverse_proxy 127.0.0.1:3200 {
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
      header_up X-Real-IP {remote_host}
    }
  }
}

