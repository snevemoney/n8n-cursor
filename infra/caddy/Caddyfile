# Global error handling
{
  # Global options
  auto_https off
  servers {
    metrics
  }
  
  # Logging
  log {
    output file /var/log/caddy/access.log {
      roll_size 100mb
      roll_keep 5
      roll_keep_for 720h
    }
    format json
    level INFO
  }
  
  # Error handling
  errors {
    * {
      respond "Service temporarily unavailable" 503
    }
  }
}
