# Production Caddyfile for LightningFlow AI
# All services bind to 127.0.0.1 - Caddy is the only public listener

(common) {
  encode gzip zstd
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; frame-ancestors 'none';"
  }
}

# Legacy LightningFlow hosts
lightningflow.online, www.lightningflow.online {
  import common
  handle /api/* {
    rewrite * /lightningflow{uri}
    reverse_proxy 127.0.0.1:3202
  }
  handle { redir https://evenslouis.ca/lightningflow{uri} permanent }
}

app.lightningflow.online {
  redir https://evenslouis.ca/lightningflow/dashboard{uri} permanent
}

ops.lightningflow.online {
  redir https://evenslouis.ca/lightningflow/ops{uri} permanent
}

api.lightningflow.online {
  rewrite * /lightningflow/api{uri}
  reverse_proxy 127.0.0.1:3202
}

docs.lightningflow.online {
  redir https://evenslouis.ca/lightningflow/docs{uri} permanent
}

# n8n (legacy apex — dual-host during cutover; UI redirects to evenslouis.ca/n8n)
n8ncloud.tech, www.n8ncloud.tech {
  import common
  handle /webhook* { reverse_proxy 127.0.0.1:5678 }
  handle /webhook-test* { reverse_proxy 127.0.0.1:5678 }
  handle /rest* { reverse_proxy 127.0.0.1:5678 }
  handle /api* { reverse_proxy 127.0.0.1:5678 }
  @health path /healthz
  handle @health { reverse_proxy 127.0.0.1:5678 }
  handle { redir https://evenslouis.ca/n8n{uri} permanent }
}

# Personal site + n8n under /n8n (strip prefix; proxy absolute editor assets)
evenslouis.ca, www.evenslouis.ca {
  import common
  handle /builder/* { reverse_proxy 127.0.0.1:3001 }
  @n8nExact path /n8n
  redir @n8nExact /n8n/ permanent
  handle /static/base-path.js {
    header Content-Type text/javascript
    respond "window.BASE_PATH = '/n8n/';" 200
  }
  handle_path /n8n/* { reverse_proxy 127.0.0.1:5678 }
  handle /assets* { reverse_proxy 127.0.0.1:5678 }
  handle /static* { reverse_proxy 127.0.0.1:5678 }
  handle /types* { reverse_proxy 127.0.0.1:5678 }
  handle /rest* { reverse_proxy 127.0.0.1:5678 }
  handle /webhook* { reverse_proxy 127.0.0.1:5678 }
  handle /webhook-test* { reverse_proxy 127.0.0.1:5678 }
  handle /icon* { reverse_proxy 127.0.0.1:5678 }
  handle /favicon.ico { reverse_proxy 127.0.0.1:5678 }
  @lightningflowRoot path /lightningflow /lightningflow/
  handle @lightningflowRoot { reverse_proxy 127.0.0.1:3201 }
  handle /lightningflow/healthz { reverse_proxy 127.0.0.1:3201 }
  handle_path /lightningflow/_landing/* { reverse_proxy 127.0.0.1:3201 }
  handle /lightningflow/ops* { reverse_proxy 127.0.0.1:3203 }
  handle /lightningflow* { reverse_proxy 127.0.0.1:3202 }
  handle /pro* { reverse_proxy 127.0.0.1:3204 }
  handle { reverse_proxy 127.0.0.1:3200 }
}

evenslouis.pro, www.evenslouis.pro {
  redir https://evenslouis.ca/pro{uri} permanent
}
