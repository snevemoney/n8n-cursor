{
  "name": "Master Orchestration System",
  "nodes": [
    {
      "id": "master-trigger",
      "name": "Master Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "master-orchestrator",
        "options": {}
      }
    },
    {
      "id": "request-analyzer",
      "name": "Request Analyzer",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [300, 300],
      "parameters": {
        "functionCode": "const input = $input.first().json;\n\n// Analyze incoming request and determine workflow routing\nconst request = {\n  request_id: `master_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n  timestamp: new Date().toISOString(),\n  client_ip: $input.first().headers['x-forwarded-for'] || 'unknown',\n  \n  // Core request analysis\n  primary_service: input.service || 'ai-saas',\n  sub_service: input.sub_service || '',\n  user_id: input.user_id || 'anonymous',\n  priority: input.priority || 'normal',\n  \n  // Workflow routing logic\n  workflow_routing: {\n    ai_saas: input.service === 'ai-saas',\n    research: input.service === 'research',\n    content_creation: input.service === 'content',\n    support: input.service === 'support',\n    analytics: input.service === 'analytics'\n  },\n  \n  // Service tier and features\n  service_tier: input.service_tier || 'basic',\n  features_requested: input.features || [],\n  \n  // Content-specific parameters\n  content_type: input.content_type || '',\n  platforms: input.platforms || [],\n  \n  // AI configuration\n  ai_config: {\n    model: input.model || 'gpt-4',\n    temperature: input.temperature || 0.7,\n    max_tokens: input.max_tokens || 2000\n  },\n  \n  // Validation and routing\n  validated: false,\n  routing_decision: '',\n  errors: []\n};\n\n// Validate and determine routing\nif (!request.primary_service) {\n  request.errors.push('Primary service is required');\n}\n\n// Determine workflow routing\nif (request.workflow_routing.ai_saas) {\n  request.routing_decision = 'ai-saas-master-scaffold';\n} else if (request.workflow_routing.research) {\n  request.routing_decision = 'ai-research-agent';\n} else if (request.workflow_routing.content_creation) {\n  request.routing_decision = 'ai-content-empire';\n} else if (request.workflow_routing.support) {\n  request.routing_decision = 'gpt5-support-agent';\n} else if (request.workflow_routing.analytics) {\n  request.routing_decision = 'analytics-dashboard';\n}\n\nrequest.validated = request.errors.length === 0;\n\nreturn request;"
      }
    },
    {
      "id": "workflow-router",
      "name": "Workflow Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [500, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.routing_decision }}",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.routing_decision }}",
                    "rightValue": "ai-saas-master-scaffold",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ai-saas"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.routing_decision }}",
                    "rightValue": "ai-research-agent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "research"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.routing_decision }}",
                    "rightValue": "ai-content-empire",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "content"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.routing_decision }}",
                    "rightValue": "gpt5-support-agent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "support"
            }
          ]
        },
        "fallbackOutput": "single"
      }
    },
    {
      "id": "ai-saas-workflow",
      "name": "AI SaaS Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/ai-saas-hook",
        "authentication": "none",
        "headers": {
          "Content-Type": "application/json",
          "X-Request-ID": "={{ $json.request_id }}",
          "X-Source": "master-orchestrator"
        },
        "body": {
          "action": "={{ $json.sub_service || 'chat' }}",
          "message": "={{ $json.content_type || $json.sub_service || 'General request' }}",
          "user_id": "={{ $json.user_id }}",
          "service_tier": "={{ $json.service_tier }}",
          "context": "={{ $json.features_requested.join(', ') }}",
          "ai_config": "={{ $json.ai_config }}",
          "master_request_id": "={{ $json.request_id }}"
        },
        "options": {
          "allowUnauthorizedCerts": false,
          "timeout": 30000
        }
      }
    },
    {
      "id": "research-workflow",
      "name": "Research Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/research-agent",
        "authentication": "none",
        "headers": {
          "Content-Type": "application/json",
          "X-Request-ID": "={{ $json.request_id }}",
          "X-Source": "master-orchestrator"
        },
        "body": {
          "question": "={{ $json.content_type || 'Research request' }}",
          "context": "={{ $json.features_requested.join(', ') }}",
          "depth": "={{ $json.service_tier === 'enterprise' ? 'comprehensive' : 'standard' }}",
          "sources": "={{ $json.platforms.length > 0 ? $json.platforms : ['academic', 'industry', 'news'] }}",
          "requester": "={{ $json.user_id }}",
          "master_request_id": "={{ $json.request_id }}"
        },
        "options": {
          "allowUnauthorizedCerts": false,
          "timeout": 60000
        }
      }
    },
    {
      "id": "content-workflow",
      "name": "Content Creation Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 400],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/content-creation",
        "authentication": "none",
        "headers": {
          "Content-Type": "application/json",
          "X-Request-ID": "={{ $json.request_id }}",
          "X-Source": "master-orchestrator"
        },
        "body": {
          "content_type": "={{ $json.content_type || 'blog_post' }}",
          "topic": "={{ $json.sub_service || 'General content' }}",
          "platforms": "={{ $json.platforms }}",
          "user_id": "={{ $json.user_id }}",
          "service_tier": "={{ $json.service_tier }}",
          "ai_config": "={{ $json.ai_config }}",
          "master_request_id": "={{ $json.request_id }}"
        },
        "options": {
          "allowUnauthorizedCerts": false,
          "timeout": 90000
        }
      }
    },
    {
      "id": "support-workflow",
      "name": "Support Agent Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 500],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/support-agent",
        "authentication": "none",
        "headers": {
          "Content-Type": "application/json",
          "X-Request-ID": "={{ $json.request_id }}",
          "X-Source": "master-orchestrator"
        },
        "body": {
          "query": "={{ $json.content_type || 'Support request' }}",
          "user_id": "={{ $json.user_id }}",
          "priority": "={{ $json.priority }}",
          "service_tier": "={{ $json.service_tier }}",
          "context": "={{ $json.features_requested.join(', ') }}",
          "master_request_id": "={{ $json.request_id }}"
        },
        "options": {
          "allowUnauthorizedCerts": false,
          "timeout": 45000
        }
      }
    },
    {
      "id": "workflow-results-merger",
      "name": "Workflow Results Merger",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "mode": "append",
        "joinMode": "waitForAll",
        "outputDataFrom": "input1"
      }
    },
    {
      "id": "analytics-tracker",
      "name": "Analytics Tracker",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1100, 300],
      "parameters": {
        "functionCode": "const originalRequest = $node['Request Analyzer'].json;\nconst workflowResults = $input.all();\n\n// Extract workflow execution results\nconst results = workflowResults.map(item => {\n  const data = item.json;\n  return {\n    workflow_name: data.workflow_name || 'unknown',\n    execution_time: data.execution_time || 0,\n    success: data.success !== false,\n    tokens_used: data.tokens_used || 0,\n    response_size: data.response_size || 0,\n    error_message: data.error_message || null\n  };\n});\n\n// Calculate analytics\nconst analytics = {\n  master_request_id: originalRequest.request_id,\n  timestamp: new Date().toISOString(),\n  \n  // Request metadata\n  request_info: {\n    primary_service: originalRequest.primary_service,\n    sub_service: originalRequest.sub_service,\n    user_id: originalRequest.user_id,\n    service_tier: originalRequest.service_tier,\n    priority: originalRequest.priority\n  },\n  \n  // Workflow execution results\n  workflow_executions: results,\n  \n  // Performance metrics\n  performance: {\n    total_execution_time: results.reduce((sum, r) => sum + (r.execution_time || 0), 0),\n    total_tokens_used: results.reduce((sum, r) => sum + (r.tokens_used || 0), 0),\n    success_rate: results.filter(r => r.success).length / results.length,\n    workflows_executed: results.length\n  },\n  \n  // Business metrics\n  business_metrics: {\n    service_tier_usage: originalRequest.service_tier,\n    feature_utilization: originalRequest.features_requested.length,\n    user_engagement: originalRequest.user_id !== 'anonymous' ? 'identified' : 'anonymous'\n  },\n  \n  // Quality metrics\n  quality_metrics: {\n    overall_success: results.every(r => r.success),\n    average_response_size: results.reduce((sum, r) => sum + (r.response_size || 0), 0) / results.length,\n    error_count: results.filter(r => !r.success).length\n  }\n};\n\nreturn analytics;"
      }
    },
    {
      "id": "database-storage",
      "name": "Database Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1300, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/master_analytics",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "headers": {
          "Content-Type": "application/json",
          "Prefer": "return=representation"
        },
        "body": "={{ $json }}",
        "options": {
          "allowUnauthorizedCerts": false
        }
      }
    },
    {
      "id": "notification-system",
      "name": "Notification System",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1300, 400],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "embeds": [
            {
              "title": "🎯 Master Orchestrator Activity",
              "description": "Workflow orchestration completed",
              "color": 3447003,
              "fields": [
                {
                  "name": "Request ID",
                  "value": "{{ $node['Request Analyzer'].json['request_id'] }}",
                  "inline": true
                },
                {
                  "name": "Service",
                  "value": "{{ $node['Request Analyzer'].json['primary_service'] }}",
                  "inline": true
                },
                {
                  "name": "User",
                  "value": "{{ $node['Request Analyzer'].json['user_id'] }}",
                  "inline": true
                },
                {
                  "name": "Success Rate",
                  "value": "{{ Math.round($json.performance.success_rate * 100) }}%",
                  "inline": true
                },
                {
                  "name": "Workflows Executed",
                  "value": "{{ $json.performance.workflows_executed }}",
                  "inline": true
                },
                {
                  "name": "Total Tokens",
                  "value": "{{ $json.performance.total_tokens_used }}",
                  "inline": true
                }
              ],
              "timestamp": "{{ new Date().toISOString() }}"
            }
          ]
        }
      }
    },
    {
      "id": "response-assembler",
      "name": "Response Assembler",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1500, 300],
      "parameters": {
        "functionCode": "const originalRequest = $node['Request Analyzer'].json;\nconst analytics = $node['Analytics Tracker'].json;\nconst dbResult = $node['Database Storage'].json;\n\n// Assemble comprehensive response\nconst response = {\n  success: true,\n  master_request_id: originalRequest.request_id,\n  timestamp: new Date().toISOString(),\n  \n  // Service execution summary\n  service_execution: {\n    primary_service: originalRequest.primary_service,\n    sub_service: originalRequest.sub_service,\n    workflow_routed: originalRequest.routing_decision,\n    execution_status: 'completed'\n  },\n  \n  // Results from individual workflows\n  workflow_results: analytics.workflow_executions,\n  \n  // Performance summary\n  performance_summary: {\n    total_execution_time: analytics.performance.total_execution_time,\n    total_tokens_used: analytics.performance.total_tokens_used,\n    success_rate: analytics.performance.success_rate,\n    workflows_executed: analytics.performance.workflows_executed\n  },\n  \n  // Quality metrics\n  quality_metrics: {\n    overall_success: analytics.quality_metrics.overall_success,\n    error_count: analytics.quality_metrics.error_count,\n    average_response_size: analytics.quality_metrics.average_response_size\n  },\n  \n  // Business insights\n  business_insights: {\n    service_tier_utilization: analytics.business_metrics.service_tier_usage,\n    feature_adoption: analytics.business_metrics.feature_utilization,\n    user_engagement_level: analytics.business_metrics.user_engagement\n  },\n  \n  // Storage and notification\n  system_status: {\n    analytics_stored: !!dbResult,\n    notifications_sent: true,\n    database_id: dbResult?.[0]?.id || null\n  },\n  \n  // Next steps and recommendations\n  recommendations: {\n    performance_optimization: analytics.performance.total_execution_time > 30000 ? 'Consider workflow optimization' : 'Performance is optimal',\n    cost_optimization: analytics.performance.total_tokens_used > 5000 ? 'High token usage detected' : 'Token usage is reasonable',\n    quality_improvement: analytics.quality_metrics.error_count > 0 ? 'Review error logs for improvements' : 'All workflows executed successfully'\n  },\n  \n  // Metadata\n  metadata: {\n    orchestrator_version: '2.0',\n    api_version: '1.0',\n    processing_status: 'completed'\n  }\n};\n\nreturn response;"
      }
    },
    {
      "id": "master-response",
      "name": "Master Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1700, 300],
      "parameters": {
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "Content-Type": "application/json",
            "X-Request-ID": "={{ $json.master_request_id }}",
            "X-Execution-Time": "={{ $json.performance_summary.total_execution_time }}ms",
            "X-Success-Rate": "={{ Math.round($json.performance_summary.success_rate * 100) }}%"
          }
        }
      }
    }
  ],
  "connections": {
