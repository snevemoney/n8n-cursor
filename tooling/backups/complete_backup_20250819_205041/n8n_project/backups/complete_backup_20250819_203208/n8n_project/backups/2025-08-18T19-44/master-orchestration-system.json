            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "AI SaaS Workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI SaaS Workflow": {
      "main": [
        [
          {
            "node": "Workflow Results Merger",
            "type": "main",
