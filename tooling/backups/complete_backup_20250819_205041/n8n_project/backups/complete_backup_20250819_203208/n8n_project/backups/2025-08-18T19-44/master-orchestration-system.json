          }
        ]
      ]
    },
    "Content Creation Workflow": {
      "main": [
        [
          {
            "node": "Workflow Results Merger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Support Agent Workflow": {
      "main": [
        [
          {
