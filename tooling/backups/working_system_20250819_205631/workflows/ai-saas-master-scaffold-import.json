          }
        ]
      ]
    },
    "🗄️ Supabase Insert": {
      "main": [
        [
          {
            "node": "🔄 Merge Results",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "💬 Discord Notify": {
      "main": [
        [
          {
            "node": "🔄 Merge Results",
            "type": "main",
            "index": 2
          }
        ]
      ]
    },
    "🔄 Merge Results": {
      "main": [
        [
          {
