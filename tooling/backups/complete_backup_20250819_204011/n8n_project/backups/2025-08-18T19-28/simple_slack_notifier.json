{
  "name": "Simple Slack Notifier",
  "active": false,
  "nodes": [
    {
      "id": "3d07e7dd5cb7632caa97bd06",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "/slack-notify",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "286dc554764211c974fe5d78",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "message",
              "value": "{{$json.message || 'Default notification'}}"
            },
            {
              "name": "channel",
              "value": "{{$json.channel || '#general'}}"
            },
            {
              "name": "username",
              "value": "{{$json.username || 'n8n-bot'}}"
            }
          ]
        }
      }
    },
    {
      "id": "8aae1b0cb3ca4291aff71094",
      "name": "Check Message Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "conditions": {
          "boolean": [],
          "number": [],
          "string": []
        },
        "mode": "expression",
        "expression": "{{$json.message && $json.message.length > 0}}"
      }
    },
    {
      "id": "37bbb494dfabbf760ff66808",
      "name": "Send Slack Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/{{secrets.SLACK_WEBHOOK_URL}}",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "{\"text\":\"{{$json.message}}\",\"channel\":\"{{$json.channel}}\",\"username\":\"{{$json.username}}\",\"icon_emoji\":\":robot_face:\"}"
      }
    }
  ],
  "connections": {
    "Extract Message Data": {
      "main": [
        [
          {
            "node": "Check Message Exists",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Message Exists": {
      "main": [
        [
          {
            "node": "Send Slack Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": null,
  "pinData": null
}