# Production Environment Variables for lightningflow.online
# Copy this to .env.production and fill in your actual production values

# Supabase (Production project - never reuse from other envs)
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key
SUPABASE_SERVICE_ROLE=your-prod-service-role-key

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=4000
NODE_ENV=production

# n8n Configuration
N8N_URL=http://n8ncloud.tech:5678
N8N_API_KEY=prod-api-key
N8N_WEBHOOK_SECRET=prod-webhook-secret

# Workflow Signing
WORKFLOW_SIGNING_SECRET_LFAI=prod-signing-secret

# LNbits (Production wallet only!)
LNBITS_API_URL=https://legend.lnbits.com
LNBITS_API_KEY=your-prod-wallet-key
WEBHOOK_TOKEN=prod_webhook_token
ALLOWED_WEBHOOK_HOST_SUFFIX=lightningflow.online,n8ncloud.tech

# Email (Production SMTP)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass

# Security
JWT_SECRET=prod-jwt-secret
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=info

# Feature Flags
NEXT_PUBLIC_FF_NEW_DASH=false

# Basic Auth for Production
OPS_USER=admin
OPS_PASS=your-secure-ops-password

# Domain Configuration
NEXT_PUBLIC_APP_URL=https://lightningflow.online
NEXT_PUBLIC_API_URL=https://lightningflow.online/api
