# LightningFlow AI - Monitoring Stack Environment
# Copy to .env.monitoring and customize

# =============================================================================
# MONITORING STACK CONFIGURATION
# =============================================================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=lightningflow2024
GRAFANA_PORT=3000

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_DAYS=30

# Loki (Log Aggregation)
LOKI_PORT=3100

# Uptime Kuma
UPTIME_KUMA_PORT=3001

# MinIO (S3-Compatible Storage)
MINIO_ROOT_USER=lightningflow
MINIO_ROOT_PASSWORD=lightningflow2024
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Postgres
POSTGRES_DB=lightningflow
POSTGRES_USER=lightningflow
POSTGRES_PASSWORD=lightningflow2024
POSTGRES_PORT=5432

# Caddy (Reverse Proxy)
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# Slack (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# PagerDuty (for incidents)
PAGERDUTY_API_KEY=your-pagerduty-key
PAGERDUTY_SERVICE_ID=your-service-id

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT Secret for internal services
JWT_SECRET=your-super-secret-jwt-key-here

# API Keys
LIGHTNINGFLOW_API_KEY=your-api-key-here
N8N_API_KEY=your-n8n-api-key-here

# =============================================================================
# STORAGE & BACKUP
# =============================================================================

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# S3 Backup (if using external S3)
S3_BACKUP_BUCKET=lightningflow-backups
S3_BACKUP_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# =============================================================================
# PERFORMANCE & SCALING
# =============================================================================

# Resource Limits
GRAFANA_MEMORY_LIMIT=512M
PROMETHEUS_MEMORY_LIMIT=1G
LOKI_MEMORY_LIMIT=512M
POSTGRES_MEMORY_LIMIT=1G
REDIS_MEMORY_LIMIT=256M

# Retention Policies
METRICS_RETENTION_DAYS=30
LOGS_RETENTION_DAYS=14
TRACES_RETENTION_DAYS=7

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Debug Mode
DEBUG=false
LOG_LEVEL=info

# Development Overrides
SKIP_SSL_VERIFY=false
ALLOW_INSECURE_CONNECTIONS=false
