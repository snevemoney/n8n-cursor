# Development Environment Variables
# Copy this to .env.dev and fill in your values

# Supabase (Integration project - safe for dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-int-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=4000
NODE_ENV=development

# n8n Configuration
N8N_URL=http://n8n.local:5678
N8N_API_KEY=dev-api-key
N8N_WEBHOOK_SECRET=dev-webhook-secret

# Workflow Signing
WORKFLOW_SIGNING_SECRET_LFAI=dev-signing-secret

# LNbits (dev wallet only!)
LNBITS_API_URL=https://legend.lnbits.com
LNBITS_API_KEY=your-dev-wallet-key
WEBHOOK_TOKEN=dev_webhook_token
ALLOWED_WEBHOOK_HOST_SUFFIX=lightningflow.local,api.lightningflow.local

# Email (dev to MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Security
JWT_SECRET=dev-jwt-secret
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Feature Flags
NEXT_PUBLIC_FF_NEW_DASH=true
