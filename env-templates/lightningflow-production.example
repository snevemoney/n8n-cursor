# LightningFlow AI - Production Environment
# Copy this to apps/lightningflow/.env.production and fill in your values
# WARNING: Never commit real secrets to git!

# Environment
NODE_ENV=production
NEXT_PUBLIC_APP_MODE=production
NEXT_PUBLIC_MOCK_MODE=false

# Lightning Network (Production)
NEXT_PUBLIC_LIGHTNING_NETWORK=mainnet

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.lfa.example.com

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_TRUST_TILES=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Supabase (Production)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_KEY=your-production-service-role-key

# OpenAI (Production)
OPENAI_API_KEY=sk-your-openai-api-key

# Lightning Network (Production)
LIGHTNING_NETWORK=mainnet
LNBITS_URL=https://lnbits.example.com
LNBITS_ADMIN_KEY=your-production-admin-key

# Redis (Production)
REDIS_URL=redis://production-redis:6379

# Database (Production)
DATABASE_URL=postgresql://postgres:password@production-postgres:5432/lightningflow_prod

# Security (Production)
SESSION_SECRET=your-session-secret-here
ENCRYPTION_KEY=your-encryption-key-here
