# n8n-cursor - Local Development Environment
# Copy this to apps/n8n-cursor/.env.local and fill in your values

# Environment
NODE_ENV=development
APP_MODE=local

# n8n Instance (Local)
N8N_BASE_URL=http://localhost:5678
N8N_EMAIL=admin@example.com
N8N_PASSWORD=your-password-here

# MCP Configuration
MCP_SERVER_URL=http://localhost:3001
MCP_SERVER_PORT=3001

# Development Settings
ENABLE_DEBUG=true
LOG_LEVEL=debug
ENABLE_MOCK_MODE=true

# Workflow Management
WORKFLOWS_DIR=./workflows
EXPORT_DIR=./workflows/raw
NORMALIZED_DIR=./workflows/normalized

# Testing
TEST_MODE=true
MOCK_N8N_RESPONSES=true
