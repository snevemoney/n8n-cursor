# Integration Environment Variables
# Copy this to .env.int and fill in your values

# Supabase (Integration project - safe for testing)
NEXT_PUBLIC_SUPABASE_URL=https://your-int-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-int-anon-key
SUPABASE_SERVICE_ROLE=your-int-service-role-key

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=4000
NODE_ENV=integration

# n8n Configuration
N8N_URL=http://int.n8ncloud.tech:5678
N8N_API_KEY=int-api-key
N8N_WEBHOOK_SECRET=int-webhook-secret

# Workflow Signing
WORKFLOW_SIGNING_SECRET_LFAI=int-signing-secret

# LNbits (integration wallet only!)
LNBITS_API_URL=https://legend.lnbits.com
LNBITS_API_KEY=your-int-wallet-key
WEBHOOK_TOKEN=int_webhook_token
ALLOWED_WEBHOOK_HOST_SUFFIX=int.lightningflow.online,int.n8ncloud.tech

# Email (integration to MailHog or test service)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Security
JWT_SECRET=int-jwt-secret
API_RATE_LIMIT=200

# Logging
LOG_LEVEL=debug

# Feature Flags
NEXT_PUBLIC_FF_NEW_DASH=true

# Basic Auth for Integration
OPS_INT_USER=admin
OPS_INT_PASS=integration123
N8N_INT_USER=admin
N8N_INT_PASS=integration123