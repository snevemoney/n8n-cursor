# Staging Environment Variables
# Copy this to .env.staging and fill in your values

# Supabase (Staging project - separate from prod)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE=your-staging-service-role-key

# Redis
REDIS_URL=redis://127.0.0.1:6381/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=

# Server Configuration
PORT=4000
NODE_ENV=staging

# n8n Configuration
N8N_URL=http://staging.n8ncloud.tech:5678
N8N_API_KEY=staging-api-key
N8N_WEBHOOK_SECRET=staging-webhook-secret

# Workflow Signing
WORKFLOW_SIGNING_SECRET_LFAI=staging-signing-secret

# LNbits (staging wallet only!)
LNBITS_API_URL=https://legend.lnbits.com
LNBITS_API_KEY=your-staging-wallet-key
WEBHOOK_TOKEN=staging_webhook_token
ALLOWED_WEBHOOK_HOST_SUFFIX=staging.lightningflow.online,staging.n8ncloud.tech

# Email (staging to test service)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Security
JWT_SECRET=staging-jwt-secret
API_RATE_LIMIT=150

# Logging
LOG_LEVEL=info

# Feature Flags
NEXT_PUBLIC_FF_NEW_DASH=true

# Basic Auth for Staging
STAGING_USER=admin
STAGING_PASS=staging123
OPS_STAGING_USER=admin
OPS_STAGING_PASS=staging123
N8N_STAGING_USER=admin
N8N_STAGING_PASS=staging123
