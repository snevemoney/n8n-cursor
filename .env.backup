# Multi-Environment n8n Configuration
# Copy this to .env and fill in your actual values

# =============================================================================
# LOCAL DEVELOPMENT (Your laptop)
# =============================================================================
N8N_LOCAL_ENABLED=1
N8N_LOCAL_BASE_URL=http://localhost:5678
N8N_LOCAL_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkYjYxOWE3MC1jMzQ2LTQ0NDQtODlkZi0zZTUxODE1MjhhMzQiLCJpc3MiOiJuOG4iLCJhdWQiOiJwdWJsaWMtYXBpIiwiaWF0IjoxNzU2MDg5MzI1fQ.dDOehBHR-XKB78w4HDHOjeAL0OxpLRT1s-wCVfl636k

# =============================================================================
# INTEGRATION (Services talk together)
# =============================================================================
N8N_INT_ENABLED=0
N8N_INT_BASE_URL=https://n8n-integration.yourdomain.com
N8N_INT_API_KEY=your_integration_n8n_api_key_here

# =============================================================================
# TESTING (Automated tests, CI/CD)
# =============================================================================
N8N_TEST_ENABLED=0
N8N_TEST_BASE_URL=https://n8n-testing.yourdomain.com
N8N_TEST_API_KEY=your_testing_n8n_api_key_here

# =============================================================================
# STAGING (Production-like, manual QA)
# =============================================================================
N8N_STG_ENABLED=0
N8N_STG_BASE_URL=https://n8n-staging.yourdomain.com
N8N_STG_API_KEY=your_staging_n8n_api_key_here

# =============================================================================
# PRODUCTION (Live system)
# =============================================================================
N8N_PRD_ENABLED=0
N8N_PRD_BASE_URL=https://n8ncloud.tech
N8N_PRD_API_KEY=your_production_n8n_api_key_here

# =============================================================================
# SERVER-TO-LOCAL SYNC (Pull from production to local)
# =============================================================================
# Source = your production server
SRC_BASE=https://n8ncloud.tech
SRC_KEY=your_production_n8n_api_key_here

# Target = your local n8n
LOCAL_BASE=http://localhost:5678
LOCAL_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkYjYxOWE3MC1jMzQ2LTQ0NDQtODlkZi0zZTUxODE1MjhhMzQiLCJpc3MiOiJuOG4iLCJhdWQiOiJwdWJsaWMtYXBpIiwiaWF0IjoxNzU2MDg5MzI1fQ.dDOehBHR-XKB78w4HDHOjeAL0OxpLRT1s-wCVfl636k

# Optional: URL rewriting when syncing down
DOWN_REPLACE_BASE=https://api.yourdomain.com
DOWN_WITH_BASE=http://localhost:3000
DOWN_WEBHOOK_PREFIX=local-

# =============================================================================
# PROMOTION CONFIGURATION (Environment-to-environment)
# =============================================================================
# These are set dynamically during promotion, but you can override:

# Webhook path prefixes per environment
PROMOTE_PREFIX_INT=int-
PROMOTE_PREFIX_TEST=test-
PROMOTE_PREFIX_STG=stg-
PROMOTE_PREFIX_PRD=prod-

# HTTP base URL replacements (if your workflows call external APIs)
PROMOTE_REPLACE_BASE=http://localhost:3000
PROMOTE_WITH_BASE_INT=https://int-api.yourdomain.com
PROMOTE_WITH_BASE_TEST=https://test-api.yourdomain.com
PROMOTE_WITH_BASE_STG=https://stg-api.yourdomain.com
PROMOTE_WITH_BASE_PRD=https://api.yourdomain.com

# =============================================================================
# OTHER MCP SERVERS
# =============================================================================
BRAVE_ENABLED=1
BRAVE_API_KEY=your_brave_search_api_key_here

N8N_ASSISTANT_ENABLED=1
SMITHERY_ASSISTANT_KEY=your_smithery_assistant_key_here

# =============================================================================
# USAGE EXAMPLES
# =============================================================================
# 
# 1. Pull everything from production to local:
#    npm run sync:down
#
# 2. Promote workflow from local to integration:
#    N8N_SOURCE_BASE_URL=$N8N_LOCAL_BASE_URL N8N_SOURCE_API_KEY=$N8N_LOCAL_API_KEY \
#    N8N_TARGET_BASE_URL=$N8N_INT_BASE_URL N8N_TARGET_API_KEY=$N8N_INT_API_KEY \
#    npm run promote -- --name "My Workflow"
#
# 3. Promote and activate from integration to testing:
#    N8N_SOURCE_BASE_URL=$N8N_INT_BASE_URL N8N_SOURCE_API_KEY=$N8N_INT_API_KEY \
#    N8N_TARGET_BASE_URL=$N8N_TEST_BASE_URL N8N_TARGET_API_KEY=$N8N_TEST_API_KEY \
#    npm run promote:activate -- --name "My Workflow"
#
# 4. Promote from testing to staging:
#    N8N_SOURCE_BASE_URL=$N8N_TEST_BASE_URL N8N_SOURCE_API_KEY=$N8N_TEST_API_KEY \
#    N8N_TARGET_BASE_URL=$N8N_STG_BASE_URL N8N_TARGET_API_KEY=$N8N_STG_API_KEY \
#    npm run promote -- --name "My Workflow"
#
# 5. Promote and activate from staging to production:
#    N8N_SOURCE_BASE_URL=$N8N_STG_BASE_URL N8N_SOURCE_API_KEY=$N8N_STG_API_KEY \
#    N8N_TARGET_BASE_URL=$N8N_PRD_BASE_URL N8N_TARGET_API_KEY=$N8N_PRD_API_KEY \
#    npm run promote:activate -- --name "My Workflow"
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. NEVER commit this file to Git
# 2. Rotate API keys regularly
# 3. Use different API keys for each environment
# 4. Consider using a secrets manager for production
# 5. Enable RBAC in n8n for production environments
