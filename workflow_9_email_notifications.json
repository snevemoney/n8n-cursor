{
  "name": "Email Notification System",
  "nodes": [
    {
      "parameters": {
        "path": "/notifications/email",
        "httpMethod": "POST"
      },
      "id": "email-webhook-entry",
      "name": "Email Notification Entry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "ALL"
      },
      "id": "split-notifications",
      "name": "Split Notifications",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Route to different email types based on type\nconst emailType = $input.item.json.type || 'generic';\n\n// Map email types to templates\nconst templateMap = {\n  'welcome': 'welcome_email',\n  'verification': 'verification_email',\n  'password-reset': 'password_reset_email',\n  'work-order': 'work_order_notification',\n  'compliance-alert': 'compliance_alert_email',\n  'monthly-report': 'monthly_report_email'\n};\n\nreturn {\n  json: {\n    emailType,\n    template: templateMap[emailType] || 'generic_email',\n    recipient: $input.item.json.recipient,\n    data: $input.item.json.data || {}\n  }\n};"
      },
      "id": "route-email-type",
      "name": "Route Email Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "welcome-condition",
              "leftValue": "={{ $json.emailType }}",
              "rightValue": "welcome",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "verification-condition",
              "leftValue": "={{ $json.emailType }}",
              "rightValue": "verification",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "password-reset-condition",
              "leftValue": "={{ $json.emailType }}",
              "rightValue": "password-reset",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "work-order-condition",
              "leftValue": "={{ $json.emailType }}",
              "rightValue": "work-order",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "compliance-condition",
              "leftValue": "={{ $json.emailType }}",
              "rightValue": "compliance-alert",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "monthly-report-condition",
              "leftValue": "={{ $json.emailType }}",
              "rightValue": "monthly-report",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-email-type",
      "name": "Route by Email Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "noreply@n8ncloud.tech",
        "toEmail": "={{ $json.recipient }}",
        "subject": "Welcome to Your SaaS Platform!",
        "html": "={{ `<h1>Welcome {{ $json.data.name }}!</h1><p>We're excited to have you on board.</p>` }}",
        "options": {}
      },
      "id": "send-welcome",
      "name": "Send Welcome Email",
