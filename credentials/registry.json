{
  "version": "1.0.0",
  "description": "LightningFlow AI - n8n Credential Registry",
  "credentials": {
    "Supabase Service": {
      "type": "n8n-nodes-base.supabase",
      "description": "Service role key for database operations",
      "env_vars": {
        "SUPABASE_URL": "url",
        "SUPABASE_SERVICE_KEY": "apiKey"
      },
      "required": true,
      "environments": ["local", "int", "test", "stg", "prod"]
    },
    "Lightning LNbits": {
      "type": "n8n-nodes-base.httpRequest",
      "description": "LNbits Lightning backend",
      "env_vars": {
        "LNBITS_BASE_URL": "baseUrl",
        "LNBITS_API_KEY": "apiKey"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"],
      "custom_fields": {
        "headers": {
          "X-Api-Key": "={{ $env.LNBITS_API_KEY }}"
        }
      }
    },
    "Lightning LND": {
      "type": "n8n-nodes-base.httpRequest",
      "description": "LND Lightning backend",
      "env_vars": {
        "LND_REST_URL": "baseUrl",
        "LND_MACAROON": "apiKey"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"],
      "custom_fields": {
        "headers": {
          "Grpc-Metadata-macaroon": "={{ $env.LND_MACAROON }}"
        }
      }
    },
    "Slack Bot": {
      "type": "n8n-nodes-base.slack",
      "description": "Slack bot for notifications",
      "env_vars": {
        "SLACK_BOT_TOKEN": "accessToken"
      },
      "required": false,
      "environments": ["int", "test", "stg", "prod"]
    },
    "Slack Webhook": {
      "type": "n8n-nodes-base.slack",
      "description": "Slack webhook for simple notifications",
      "env_vars": {
        "SLACK_WEBHOOK_URL": "webhookUrl"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"]
    },
    "Redis": {
      "type": "n8n-nodes-base.redis",
      "description": "Redis for caching and queues",
      "env_vars": {
        "REDIS_HOST": "host",
        "REDIS_PORT": "port",
        "REDIS_PASSWORD": "password",
        "REDIS_DB": "database"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"],
      "defaults": {
        "port": 6379,
        "database": 0
      }
    },
    "PostgreSQL": {
      "type": "n8n-nodes-base.postgres",
      "description": "PostgreSQL database connection",
      "env_vars": {
        "POSTGRES_HOST": "host",
        "POSTGRES_PORT": "port",
        "POSTGRES_DATABASE": "database",
        "POSTGRES_USER": "user",
        "POSTGRES_PASSWORD": "password"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"],
      "defaults": {
        "port": 5432
      }
    },
    "MinIO": {
      "type": "n8n-nodes-base.s3",
      "description": "MinIO S3-compatible storage",
      "env_vars": {
        "MINIO_ENDPOINT": "endpoint",
        "MINIO_ACCESS_KEY": "accessKeyId",
        "MINIO_SECRET_KEY": "secretAccessKey",
        "MINIO_BUCKET": "bucket"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"],
      "custom_fields": {
        "region": "us-east-1",
        "forcePathStyle": true
      }
    },
    "Grafana": {
      "type": "n8n-nodes-base.httpRequest",
      "description": "Grafana API for dashboard management",
      "env_vars": {
        "GRAFANA_URL": "baseUrl",
        "GRAFANA_API_KEY": "apiKey"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"],
      "custom_fields": {
        "headers": {
          "Authorization": "Bearer {{ $env.GRAFANA_API_KEY }}"
        }
      }
    },
    "Prometheus": {
      "type": "n8n-nodes-base.httpRequest",
      "description": "Prometheus metrics API",
      "env_vars": {
        "PROMETHEUS_URL": "baseUrl"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"]
    },
    "Uptime Kuma": {
      "type": "n8n-nodes-base.httpRequest",
      "description": "Uptime Kuma monitoring API",
      "env_vars": {
        "UPTIME_KUMA_URL": "baseUrl",
        "UPTIME_KUMA_API_KEY": "apiKey"
      },
      "required": false,
      "environments": ["local", "int", "test", "stg", "prod"],
      "custom_fields": {
        "headers": {
          "Authorization": "Bearer {{ $env.UPTIME_KUMA_API_KEY }}"
        }
      }
    }
  },
  "metadata": {
    "last_updated": "2024-12-15T00:00:00Z",
    "maintainer": "LightningFlow AI Team",
    "notes": [
      "Credentials are synced by name across environments",
      "Values differ per environment but names stay the same",
      "Use npm run cred:sync to sync to target environment",
      "Use npm run cred:dry to see what would be synced"
    ]
  }
}
