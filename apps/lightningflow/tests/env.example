# Test environment settings for Playwright tests
# Copy this file to .env.test and fill in the values

# Base URL for testing
TEST_BASE_URL=http://localhost:3000

# Test user credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword

# Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3Mi...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIj...

# Lightning node settings
LIGHTNING_NODE_URL=http://localhost:3001
LIGHTNING_API_KEY=test-api-key
LIGHTNING_ADMIN_KEY=test-admin-key

# System check key
SYSTEM_CHECK_KEY=system-check-secret

# Test tenant - for tests that need a tenant ID
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000 