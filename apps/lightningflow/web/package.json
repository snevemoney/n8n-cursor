{
  "name": "lightning-platform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "bot:quick": "bash scripts/run-bots.sh quick",
    "bot:load": "bash scripts/run-bots.sh load",
    "bot:stress": "bash scripts/run-bots.sh stress",
    "bot:custom": "bash scripts/run-bots.sh custom",
    "bot:simulate": "tsx scripts/simulate-bots.ts",
    "bot:monitor": "tsx scripts/bot-monitor.ts",
    "test:bots": "npx playwright test tests/bots/ --project=bots",
    "test:bots:ui": "npx playwright test tests/bots/ --project=bots --ui",
    "test:bots:admin": "npx playwright test tests/bots/adminBot.spec.ts",
    "test:bots:user": "npx playwright test tests/bots/userBot.spec.ts",
    "test:bots:qa": "npx playwright test tests/bots/qaBot.spec.ts",
    "test:broken": "npx playwright test tests/bots/broken-button.spec.ts",
    "test:fail": "npm run test:broken || node scripts/self-heal/applyPatch.ts",
    "monitor:autonomous": "node ../scripts/autonomous-bot-monitor.js start",
    "monitor:status": "node ../scripts/autonomous-bot-monitor.js status",
    "bootstrap:autonomous": "node ../scripts/bootstrap-autonomous.js",
    "inspect:db": "npx tsx scripts/dev/db-inspect.ts",
    "inspect:logs": "npx tsx scripts/dev/db-inspect.ts logs",
    "inspect:failures": "npx tsx scripts/dev/db-inspect.ts failures",
    "inspect:patches": "npx tsx scripts/dev/db-inspect.ts patches",
    "inspect:analytics": "npx tsx scripts/dev/db-inspect.ts analytics",
    "heal:log": "npx tsx scripts/self-heal/log-agent.ts",
    "heal:clear": "npx tsx scripts/self-heal/log-agent.ts clear",
    "heal:export": "npx tsx scripts/self-heal/log-agent.ts export",
    "audit:system": "npx tsx scripts/audit/full-introspect.ts",
    "audit:report": "cat audit-reports/latest.json | jq",
    "audit:critical": "cat audit-reports/latest.json | jq '.security.vulnerabilities[] | select(.type == \"critical\")'",
    "admin:system-map": "npm run audit:system && echo 'Report available at /admin/system-map'",
    "introspect": "npm run audit:system"
  },
  "dependencies": {
    "@lf/shared-helpers": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.176.0",
    "3d-force-graph": "^1.77.0",
    "axios": "^1.6.5",
    "bech32": "^2.0.0",
    "bullmq": "^4.9.2",
    "chart.js": "^4.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.1.0",
    "force-graph": "^1.49.6",
    "framer-motion": "^12.15.0",
    "glob": "^11.0.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.309.0",
    "next": "^15.3.3",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "openai": "^4.103.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.33.2",
    "react-player": "^2.16.0",
    "react-use": "^17.6.0",
    "recharts": "^2.12.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sonner": "^1.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.4",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "jsdom": "^26.1.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.1.4"
  }
}
