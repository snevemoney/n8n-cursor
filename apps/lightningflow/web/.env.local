# Lightning Platform Environment Configuration
# Copy this file to .env.local and fill in your values

# ========================================
# REQUIRED: Supabase Configuration
# ========================================
SUPABASE_URL="https://xlrxpfptulcugoqjccyf.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_KEY="your-service-role-key-here"

# ========================================
# REQUIRED: OpenAI Configuration  
# ========================================
OPENAI_API_KEY="sk-your-openai-api-key"

# ========================================
# OPTIONAL: Lightning Network Configuration
# ========================================

# LND Directory (default: ~/.lnd)
LND_DIR="/home/user/.lnd"

# Network (mainnet, testnet, regtest)
LND_NETWORK="mainnet"

# TLS Certificate Path (default: $LND_DIR/tls.cert)
LND_TLS_CERT_PATH="/home/user/.lnd/tls.cert"

# Admin Macaroon Path (default: $LND_DIR/data/chain/bitcoin/mainnet/admin.macaroon)
LND_MACAROON_PATH="/home/user/.lnd/data/chain/bitcoin/mainnet/admin.macaroon"

# RPC Server Address (default: localhost:10009)
LND_RPC_SERVER="localhost:10009"

# ========================================
# OPTIONAL: Redis Configuration (for caching)
# ========================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ========================================
# OPTIONAL: Logging & Monitoring
# ========================================

# Log Level (debug, info, warn, error)
LOG_LEVEL="info"

# Sentry DSN for error tracking
SENTRY_DSN=""

# Environment (development, staging, production)
NODE_ENV="development"

# ========================================
# OPTIONAL: Security Configuration
# ========================================

# JWT Secret for session tokens
JWT_SECRET="your-super-secret-jwt-key-here"

# CORS Origin (for API access)
CORS_ORIGIN="http://localhost:3000"

# ========================================
# OPTIONAL: LNbits Integration
# ========================================
LNBITS_URL="https://legend.lnbits.com"
LNBITS_API_KEY="your-default-lnbits-api-key"

# ========================================
# OPTIONAL: Performance Configuration
# ========================================

# Max concurrent monitoring workers
MAX_MONITORING_WORKERS="5"

# Database connection pool size
DB_POOL_SIZE="10"

# Cache TTL in seconds
CACHE_TTL="300"

# ========================================
# DEVELOPMENT ONLY
# ========================================

# Enable debug mode
DEBUG="false"

# Mock Lightning node for testing
MOCK_LND="false"

# Skip rate limiting in development
SKIP_RATE_LIMIT="false"

# =============================================
# LIGHTNING AI SAAS - ENVIRONMENT VARIABLES
# =============================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://demo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI Configuration
# Default key used when no workspace-specific key is configured
OPENAI_KEY_DEFAULT=your-default-openai-api-key

# Workspace-specific OpenAI keys (optional)
# Replace [workspace-id] with actual workspace UUID
# OPENAI_KEY_[workspace-id]=workspace-specific-openai-key

# LNbits Configuration
LNBITS_URL=https://legend.lnbits.com
# Default LNbits key used when no workspace-specific key is configured
LNBITS_KEY_DEFAULT=your-default-lnbits-api-key

# Workspace-specific LNbits keys (optional)
# Replace [workspace-id] with actual workspace UUID
# LNBITS_KEY_[workspace-id]=workspace-specific-lnbits-key

# Admin Configuration
# Set this to your user UUID for admin access
NEXT_PUBLIC_ADMIN_UID=your-admin-user-uuid-here
# Enable admin bypass for development (NEVER use in production)
ADMIN_BYPASS=true

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production, use your actual domain
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Security Configuration
# Secret for contract signing (generate a secure random string)
CONTRACT_SECRET=your-contract-signing-secret

# Database Configuration (if using external Postgres)
# DATABASE_URL=postgresql://user:password@host:port/database

# Email Configuration (for sending invitations)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Redis Configuration (for caching and background jobs)
# REDIS_URL=redis://localhost:6379

# Monitoring and Logging
# LOGFLARE_API_KEY=your-logflare-api-key
# LOGFLARE_SOURCE_TOKEN=your-logflare-source-token

# =============================================
# DEVELOPMENT SETTINGS
# =============================================

# Set to development for local development
NODE_ENV=development

# Enable debug logging
DEBUG=false

# =============================================
# PRODUCTION SETTINGS
# =============================================

# For production deployment:
# 1. Set NODE_ENV=production
# 2. Set ADMIN_BYPASS=true
# 3. Use HTTPS URLs for NEXT_PUBLIC_APP_URL
# 4. Use strong, unique secrets
# 5. Configure proper SMTP for email invitations
# 6. Set up Redis for caching and background jobs
# 7. Configure monitoring and logging services ADMIN_BYPASS=true
