# LightningFlow Production Environment
# Copy this to .env.production and configure your values

# Feature Flags - ALWAYS ENABLED IN PRODUCTION
NEXT_PUBLIC_FF_NEW_DASHBOARD=true
NEXT_PUBLIC_FF_AI_SECTIONS=true
NEXT_PUBLIC_FF_BOOST_BUSINESS=true
NEXT_PUBLIC_FF_EARNINGS_ANALYTICS=true
NEXT_PUBLIC_FF_PAYMENT_HISTORY=true
NEXT_PUBLIC_FF_SETTINGS_CENTER=true

# API Configuration
NEXT_PUBLIC_API_BASE=https://api.lightningflow.online
NEXT_PUBLIC_APP_URL=https://evenslouis.ca/lightningflow

# Node Configuration
NEXT_PUBLIC_NODE_LABEL=LightningFlow
NEXT_PUBLIC_NODE_TYPE=business

# Maintenance Mode (set to true to enable maintenance banner)
NEXT_PUBLIC_MAINTENANCE=false

# Analytics & Monitoring
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ERROR_REPORTING=true

# Security
NEXT_PUBLIC_SECURITY_HEADERS=true
NEXT_PUBLIC_CSP_ENABLED=true
