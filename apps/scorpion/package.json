{
  "name": "scorpion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "dev:trace": "NODE_OPTIONS='--trace-warnings --unhandled-rejections=strict' next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "backup": "bash ../../scripts/backup-scorpion.sh",
    "restore": "bash ../../scripts/restore-scorpion.sh",
    "health": "curl -f http://localhost:3003/api/health || exit 1",
    "metrics": "curl http://localhost:3003/api/metrics",
    "audit:install": "pnpm add -D tsx lighthouse && npx playwright install chromium",
    "audit:crawl": "tsx audit/crawl.ts",
    "audit:test": "playwright test audit/audit.spec.ts --reporter=list",
    "audit:lighthouse": "node audit/run-lighthouse.mjs",
    "audit:comprehensive": "tsx audit/comprehensive-audit.ts",
    "audit:run": "pnpm run audit:comprehensive",
    "audit:all": "pnpm run audit:comprehensive && pnpm run audit:lighthouse",
    "audit:report": "open audit/out/$(ls -t audit/out | head -1)/summary.json || cat audit/out/$(ls -t audit/out | head -1)/summary.json",
    "obs:dev": "SCORPION_DEMO=1 next dev -p 3003",
    "obs:test": "playwright test tests/e2e/observability.spec.ts",
    "chat:dev": "next dev -p 3003",
    "chat:test": "playwright test tests/e2e/chat.spec.ts"
  },
  "dependencies": {
    "@lightning-platform/core": "workspace:*",
    "@lightningflow/agent-factory": "workspace:*",
    "@lightningflow/shared-config": "workspace:*",
    "@playwright/test": "^1.56.1",
    "@scorpion/core": "workspace:*",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.0",
    "cytoscape": "^3.28.1",
    "cytoscape-dagre": "^2.5.0",
    "lucide-react": "^0.358.0",
    "next": "14.0.0",
    "playwright": "^1.56.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.2.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.7",
    "@types/cytoscape": "^3.19.16",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.0.0",
    "lighthouse": "^11.7.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.0.0"
  }
}
