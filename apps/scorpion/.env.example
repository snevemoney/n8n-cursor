# Scorpion Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ========================================
# REQUIRED: n8n Configuration
# ========================================
N8N_API_KEY=your_n8n_api_key_here
N8N_BASE_URL=https://evenslouis.ca/n8n

# ========================================
# REQUIRED: Ollama Configuration
# ========================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ========================================
# OPTIONAL: Scorpion Configuration
# ========================================
SCORPION_MODEL_SOURCE=ollama

# ========================================
# OPTIONAL: Fine-Tuning Configuration
# ========================================
# Minimum examples before auto fine-tuning
SCORPION_MIN_TRAINING_EXAMPLES=100

# Fine-tuning frequency: daily, weekly, monthly
SCORPION_FINE_TUNE_FREQUENCY=weekly

# ========================================
# OPTIONAL: Sync Configuration
# ========================================
# Knowledge sync interval (minutes)
SCORPION_SYNC_INTERVAL=5

# Workflow sync interval (seconds)
SCORPION_WORKFLOW_SYNC_INTERVAL=30
