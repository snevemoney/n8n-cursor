# Example secret - DO NOT commit real secrets
# Create with: kubectl create secret generic scorpion-secrets --from-literal=DATABASE_URL=... --namespace=scorpion
apiVersion: v1
kind: Secret
metadata:
  name: scorpion-secrets
  namespace: scorpion
type: Opaque
stringData:
  DATABASE_URL: "postgresql://user:password@postgres:5432/scorpion"
  N8N_API_URL: "https://evenslouis.ca/n8n/api/v1"
  N8N_API_KEY: "your-n8n-api-key"
  OPENAI_API_KEY: "your-openai-key"
  ANTHROPIC_API_KEY: "your-anthropic-key"
  # Add other secrets here

