{
  "name": "portfolio-brief-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Wealth Intelligence video engine — Remotion, data-driven episodes",
  "scripts": {
    "dev": "remotion studio src/index.ts --port 3333",
    "studio": "remotion studio src/index.ts --port 3333",
    "render": "remotion render src/index.ts DailyShow out/daily-2026-08-25.mp4 --log verbose",
    "render:legacy": "remotion render src/index.ts PortfolioBrief out/portfolio-brief-2026-08-25.mp4 --log verbose",
    "render:preview": "remotion render src/index.ts DailyShow out/daily-preview.mp4 --scale 0.5",
    "render:day": "bash scripts/render-day.sh",
    "render:juno": "bash scripts/render-juno-day.sh",
    "render:morning": "bash scripts/render-morning.sh",
    "render:voice": "bash scripts/render-voice.sh",
    "new-episode": "bash scripts/new-episode.sh",
    "still": "remotion still src/index.ts DailyShow out/poster.png --frame=90",
    "still:qa": "bash scripts/qa-stills.sh",
    "still:pack": "bash scripts/still-pack.sh",
    "check:delta": "npx tsx src/data/delta.check.ts",
    "check:voice": "npx tsx src/voice/scriptFromReport.check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.517",
    "@remotion/google-fonts": "4.0.517",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.517",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
